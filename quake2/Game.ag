# the string fields G_Find can match on
enum EField
    targetname : 0
    target     : 1
    team       : 2
    classname  : 3

func v3 [ x: f32, y: f32, z: f32 ] -> vec3f
    return vec3f [ x, y, z ]

func v_add [ a: vec3f, b: vec3f ] -> vec3f
    return vec3f [ a.x + b.x, a.y + b.y, a.z + b.z ]

func v_sub [ a: vec3f, b: vec3f ] -> vec3f
    return vec3f [ a.x - b.x, a.y - b.y, a.z - b.z ]

func v_scale [ a: vec3f, s: f32 ] -> vec3f
    return vec3f [ a.x * s, a.y * s, a.z * s ]

# a + s * b, VectorMA
func v_ma [ a: vec3f, s: f32, b: vec3f ] -> vec3f
    return vec3f [ a.x + s * b.x, a.y + s * b.y, a.z + s * b.z ]

func v_dot [ a: vec3f, b: vec3f ] -> f32
    return a.x * b.x + a.y * b.y + a.z * b.z

func v_len [ a: vec3f ] -> f32
    return sqrt[ a.x * a.x + a.y * a.y + a.z * a.z ]

func v_norm [ a: vec3f ] -> vec3f
    l : f32 [ v_len[ a ] ]
    if [ l == 0.0 ] return vec3f [ 0.0, 0.0, 0.0 ]
    return vec3f [ a.x / l, a.y / l, a.z / l ]

func v_neg [ a: vec3f ] -> vec3f
    return vec3f [ 0.0 - a.x, 0.0 - a.y, 0.0 - a.z ]

func v_eq [ a: vec3f, b: vec3f ] -> bool
    return a.x == b.x && a.y == b.y && a.z == b.z

func v_zero [ a: vec3f ] -> bool
    return a.x == 0.0 && a.y == 0.0 && a.z == 0.0

func v_cross [ a: vec3f, b: vec3f ] -> vec3f
    return vec3f [ a.y * b.z - a.z * b.y, a.z * b.x - a.x * b.z,
                   a.x * b.y - a.y * b.x ]

# random, crandom: 0..1 and -1..1
func frand [] -> f32
    return f32[ rand[] & 32767 ] * (1.0 / 32767.0)

func crandom [] -> f32
    return 2.0 * (frand[] - 0.5)

# vectoyaw: whole degrees, as the original truncates
func vectoyaw [ v: vec3f ] -> f32
    if [ v.y == 0.0 && v.x == 0.0 ] return 0.0
    whole : i32 [ atan2[ v.y, v.x ] * 180.0 / 3.14159265358979 ]
    yaw : f32 [ whole ]
    if [ yaw < 0.0 ] yaw = yaw + 360.0
    return yaw

# vectoangles: pitch and yaw of a direction, whole degrees
func vectoangles [ v: vec3f ] -> vec3f
    yaw : f32 [ 0.0 ]
    pitch : f32 [ 0.0 ]
    if [ v.y == 0.0 && v.x == 0.0 ]
        pitch = (v.z > 0.0) ? 90.0 : 270.0
    el
        if [ v.x != 0.0 ]
            whole : i32 [ atan2[ v.y, v.x ] * 180.0 / 3.14159265358979 ]
            yaw = whole
        el [ v.y > 0.0 ]
            yaw = 90.0
        el
            yaw = -90.0
        if [ yaw < 0.0 ] yaw = yaw + 360.0
        forward : f32 [ sqrt[ v.x * v.x + v.y * v.y ] ]
        wp : i32 [ atan2[ v.z, forward ] * 180.0 / 3.14159265358979 ]
        pitch = wp
        if [ pitch < 0.0 ] pitch = pitch + 360.0
    return vec3f [ 0.0 - pitch, yaw, 0.0 ]

# G_ProjectSource: a point offset along forward, right and up
func project_source [ point: vec3f, distance: vec3f, forward: vec3f,
                      right: vec3f ] -> vec3f
    return vec3f [ point.x + forward.x * distance.x + right.x * distance.y,
                   point.y + forward.y * distance.x + right.y * distance.y,
                   point.z + forward.z * distance.x + right.z * distance.y
                   + distance.z ]

func anglemod [ a: f32 ] -> f32
    return (360.0 / 65536.0) * f32[ i32[ a * (65536.0 / 360.0) ] & 65535 ]

# AngleVectors: forward, right and up from pitch yaw roll degrees
class Axes
    public forward : vec3f
    public right   : vec3f
    public up      : vec3f

func angle_vectors [ angles: vec3f ] -> Axes
    yaw   : f32 [ angles.y * 0.017453292 ]
    pitch : f32 [ angles.x * 0.017453292 ]
    roll  : f32 [ angles.z * 0.017453292 ]
    sy : f32 [ sin[ yaw ] ]
    cy : f32 [ cos[ yaw ] ]
    sp : f32 [ sin[ pitch ] ]
    cp : f32 [ cos[ pitch ] ]
    sr : f32 [ sin[ roll ] ]
    cr : f32 [ cos[ roll ] ]
    ax : Axes [ ]
    ax.forward = vec3f [ cp * cy, cp * sy, 0.0 - sp ]
    ax.right   = vec3f [ 0.0 - sr * sp * cy + cr * sy,
                         0.0 - sr * sp * sy - cr * cy,
                         0.0 - sr * cp ]
    ax.up      = vec3f [ cr * sp * cy + sr * sy,
                         cr * sp * sy - sr * cy, cr * cp ]
    return ax

# moveinfo_t
class MoveInfo
    public start_origin : vec3f
    public start_angles : vec3f
    public end_origin   : vec3f
    public end_angles   : vec3f
    public sound_start  : i32
