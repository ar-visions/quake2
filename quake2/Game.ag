# a pushed entity's place, for backing a blocked move out
# a sound, temp entity or muzzle flash the client side plays
class GameEvent
    public kind    : i32
    public ent     : Edict
    public origin  : vec3f
    public dir     : vec3f
    public index   : i32
    public channel : i32
    public volume  : f32
    public attenuation : f32
    public count   : i32
    public color   : i32

EVENT_SOUND : i32 [ 1 ]
EVENT_TEMP  : i32 [ 2 ]
EVENT_FLASH : i32 [ 3 ]
EVENT_FLASH2 : i32 [ 4 ]

class Pushed
    public ent    : Edict
    public origin : vec3f
    public angles : vec3f

class Game
    public bsp       : BspMap
    public world     : World
    public edicts    : vec Edict
    public num_edicts : i32
    public maxclients : i32 [ 1 ]
    public level     : Level
    public st        : SpawnTemp
    public skill     : i32 [ 1 ]
    public deathmatch : bool
    public coop       : bool
    public serverflags : i32
    public helpmessage1 : string
    public helpmessage2 : string
    public helpchanged : i32
    public lightstyles : vec i32
    public dmflags   : i32
    public spawnpoint : string [ '' ]
    public items     : vec GItem
    public num_items : i32
    public means_of_death : i32
    # capture the flag: on, each team's captures, the last one
    public ctf        : bool
    public ctf_team1  : i32
    public ctf_team2  : i32
    public ctf_last_capture : f32
    public ctf_capture_team : i32
    public ctf_techspawn : bool
    # the limits that end a deathmatch level; 0 is none
    public fraglimit  : i32
    public timelimit  : i32
    public capturelimit : i32
    # a far game's player names, by client number
    public player_names : vec string
    public sm_meat_index : i32
    public snd_fry   : i32
    public jacket_armor_index : i32
    public combat_armor_index : i32
    public body_armor_index : i32
    public power_screen_index : i32
    public power_shield_index : i32
    public quad_drop_timeout_hack : i32
    public is_quad   : bool
    public is_silenced : i32
    public sv_maxvelocity : f32 [ 2000.0 ]
    public sv_gravity : f32 [ 800.0 ]
    public g_select_empty : bool
    # the asset tables: an index per name, as the configstrings
    public sounds    : vec string
    public models    : vec string
    public images    : vec string
    # the client effects queued this frame
    public events    : vec GameEvent
    public autosaved : bool
    # SV_Impact's plane: a copy kept for the touch that reads it
    public touch_plane : Trace
    public touch_plane_on : bool
    # the level ends: a restart (single player death) or the next map
    public restart   : bool
    public next_map  : string
    # the player's data from the level before; null starts afresh
    public carry     : ClientPersistant
    # p_trail.c
    public trail     : vec Edict
    public trail_head : i32
    public trail_active : bool
    # p_client.c and p_view.c statics
    public death_anim : i32
    public pain_anim : i32
    public view_forward : vec3f
    public view_right : vec3f
    public view_up   : vec3f
    public xyspeed   : f32
    public bobmove   : f32
    public bobcycle  : i32
    public bobfracsin : f32
    # g_ai.c statics
    public enemy_vis : bool
    public enemy_infront : bool
    public enemy_range : i32
    public enemy_yaw : f32
    # m_flash.c
    public flash_offsets : vec f32
    public pushed    : vec Pushed
    public obstacle  : Edict
    # the edict each inline model belongs to, by model index
    public model_ent : vec Edict
    public unknown   : vec string
    public portal_open : vec bool

    public func setup [ map: BspMap ]
        g = a
        bsp = map
        world = World [ ]
        world.setup[ map ]
        level = Level [ ]
        st = SpawnTemp [ ]
        pushed = vec Pushed []
        unknown = vec string []
        model_ent = vec Edict [ map.model_head.count ]
        portal_open = vec bool [ 64 ]
        map.flood_areas[ portal_open ]
        edicts = vec Edict []
        world.edicts = edicts
        touch_plane = Trace [ ]
        sounds = vec string [] [ '' ]
        models = vec string [] [ '' ]
        # the inline models keep their own numbers: '*3' is 3
        for [ i: i32 1, i < map.model_head.count, i += 1 ]
            models.push[ '*{i}' ]
        images = vec string [] [ '' ]
        events = vec GameEvent []
        init_items[]
        if [ ctf ] ctf_items[]
        init_flash_offsets[]
        # the world and one client
        for [ i: i32 0, i <= maxclients, i += 1 ]
            e : Edict [ number: i ]
            e.moveinfo = MoveInfo [ ]
            e.monsterinfo = MonsterInfo [ ]
            edicts.push[ e ]
        num_edicts = maxclients + 1
        pl : edicts[ 1 ]
        pl.client = Client [ ]
        pl.client.ps = PlayerState [ ]
        pl.client.ps.stats = vec i32 [ 32 ]
        pl.client.pers = ClientPersistant [ ]
        pl.client.pers.inventory = vec i32 [ MAX_ITEMS ]
        pl.client.resp = ClientRespawn [ ]
        pl.client.resp.coop_respawn = ClientPersistant [ ]
        pl.client.resp.coop_respawn.inventory = vec i32 [ MAX_ITEMS ]
        pl.inuse  = true
        pl.classname = 'player'
        lightstyles = vec i32 [ 64 ]
        level.pic_health = imageindex[ 'i_health' ]
        snd_fry = soundindex[ 'player/fry.wav' ]
        sm_meat_index = modelindex[ 'models/objects/gibs/sm_meat/tris.md2' ]
        spawn_entities[ map.name, map.entities ]
        if [ ctf ] ctf_setup_tech_spawn[]
        # ClientConnect and ClientBegin for the one player
        # the game's clients outlive a level: the last one's data
        if [ carry ] pl.client.pers = carry
        el           init_client_persistant[ pl.client ]
        init_client_resp[ pl.client ]
        put_client_in_server[ pl ]
        player_trail_init[]
        client_end_server_frame[ pl ]

    # prints waiting for the server or the console: text, edict
    public printed    : vec string
    public printed_to : vec i32

    public func player [] -> Edict
        return edicts[ 1 ]

    public func dprintf [ s: string ]
        log 'game: {s}'

    # G_InitEdict
    public func init_edict [ e: Edict ]
        e.inuse = true
        e.classname = 'noclass'
        e.gravity = 1.0

    # G_Spawn: the first free slot past the clients, else a new one
    public func spawn [] -> Edict
        for [ i: i32 maxclients + 1, i < num_edicts, i += 1 ]
            e : edicts[ i ]
            if [ !e.inuse && (e.freetime < 2.0 ||
                              level.time - e.freetime > 0.5) ]
                init_edict[ e ]
                return e
        e : Edict [ number: num_edicts ]
        e.moveinfo = MoveInfo [ ]
        e.monsterinfo = MonsterInfo [ ]
        edicts.push[ e ]
        num_edicts += 1
        init_edict[ e ]
        return e

    # G_FreeEdict: unlinked and cleared, the slot kept
    public func free_edict [ ed: Edict ]
        world.unlink[ ed ]
        if [ ed.number <= maxclients ] return
        n : i32 [ ed.number ]
        ft : f32 [ level.time ]
        fresh : Edict [ number: n ]
        fresh.moveinfo = MoveInfo [ ]
        fresh.monsterinfo = MonsterInfo [ ]
        fresh.classname = 'freed'
        fresh.freetime = ft
        fresh.inuse = false
        edicts[ n ] = fresh
        # a reference kept elsewhere sees a dead edict
        ed.inuse = false
        ed.solid = SOLID_NOT
        ed.linked = false
        ed.think = null
        ed.touch = null
        ed.use = null
        ed.classname = 'freed'

    func ent_str [ e: Edict, f: EField ] -> string
        if [ f == EField.targetname ] return e.targetname
        if [ f == EField.target ] return e.target
        if [ f == EField.team ] return e.team
        return e.classname

    # G_Find: the next edict after from whose field matches
    public func find [ from: Edict, f: EField, match: string ] -> Edict
        i : i32 [ (from) ? from.number + 1 : 0 ]
        while [ i < num_edicts ]
            e : edicts[ i ]
            i += 1
            if [ !e.inuse ] continue
            s : ent_str[ e, f ]
            if [ !s ] continue
            if [ strcasecmp[ s.chars, match.chars ] == 0 ] return e
        return null

    # G_PickTarget: one of the edicts with this targetname
    public func pick_target [ targetname: string ] -> Edict
        if [ !targetname ]
            dprintf[ 'G_PickTarget called with NULL targetname' ]
            return null
        choices : vec Edict []
        e : Edict [ null ]
        while [ true ]
            e = find[ e, EField.targetname, targetname ]
            if [ !e ] break
            choices.push[ e ]
            if [ choices.count == 8 ] break
        if [ choices.count == 0 ]
            dprintf[ 'G_PickTarget: target {targetname} not found' ]
            return null
        return choices[ i32[ rand[] ] % choices.count ]

    # G_UseTargets: delayed, the message, killtargets, targets
    public func use_targets [ ent: Edict, activator: Edict ]
        if [ ent.delay != 0.0 ]
            t : spawn[]
            t.classname = 'DelayedUse'
            t.nextthink = level.time + ent.delay
            t.think = lambda think_delay[]
            t.activator = activator
            if [ !activator ] dprintf[ 'Think_Delay with no activator' ]
            t.message = ent.message
            t.target = ent.target
            t.killtarget = ent.killtarget
            return
        if [ ent.message && activator &&
             (activator.svflags & SVF_MONSTER) == 0 ]
            dprintf[ 'centerprint: {ent.message}' ]
        if [ ent.killtarget ]
            t : Edict [ null ]
            while [ true ]
                t = find[ t, EField.targetname, ent.killtarget ]
                if [ !t ] break
                free_edict[ t ]
                if [ !ent.inuse ]
                    dprintf[ 'entity was removed while using killtargets' ]
                    return
        if [ ent.target ]
            t : Edict [ null ]
            while [ true ]
                t = find[ t, EField.targetname, ent.target ]
                if [ !t ] break
                # doors fire area portals in a specific way
                if [ t.classname == 'func_areaportal' &&
                     (ent.classname == 'func_door' ||
                      ent.classname == 'func_door_rotating') ]
                    continue
                if [ t == ent ]
                    dprintf[ 'WARNING: Entity used itself.' ]
                el
                    if [ t.use ] t.use[ t, ent, activator ]
                if [ !ent.inuse ]
                    dprintf[ 'entity was removed while using targets' ]
                    return

    # G_SetMovedir: the angles become a direction, then clear
    public func set_movedir [ e: Edict ]
        if [ v_eq[ e.angles, vec3f [ 0.0, -1.0, 0.0 ] ] ]
            e.movedir = vec3f [ 0.0, 0.0, 1.0 ]
        el
            if [ v_eq[ e.angles, vec3f [ 0.0, -2.0, 0.0 ] ] ]
                e.movedir = vec3f [ 0.0, 0.0, -1.0 ]
            el
                ax : angle_vectors[ e.angles ]
                e.movedir = ax.forward
        e.angles = vec3f [ 0.0, 0.0, 0.0 ]

    # gi.setmodel: an inline model's size and index, then link
    public func setmodel [ e: Edict, name: string ]
        if [ !name ] return
        e.model = name
        if [ name[ 0 ] == 42 ]
            mi : i32 [ i32[ atoi[ @name.chars[ 1 ] ] ] ]
            e.modelindex = mi
            if [ mi > 0 && mi < bsp.model_head.count ]
                b : i32 [ mi * 6 ]
                # cmodels spread the box by a pixel
                e.mins = vec3f [ bsp.model_box[ b ] - 1.0,
                                 bsp.model_box[ b + 1 ] - 1.0,
                                 bsp.model_box[ b + 2 ] - 1.0 ]
                e.maxs = vec3f [ bsp.model_box[ b + 3 ] + 1.0,
                                 bsp.model_box[ b + 4 ] + 1.0,
                                 bsp.model_box[ b + 5 ] + 1.0 ]
                model_ent[ mi ] = e
                world.link[ e ]
        el
            e.modelindex = modelindex[ name ]

    # G_TouchTriggers: every trigger the box overlaps gets a touch
    public func touch_triggers [ ent: Edict ]
        if [ (ent.client || (ent.svflags & SVF_MONSTER) != 0) &&
             ent.health <= 0 ]
            return
        touch : world.area_edicts[ ent.absmin, ent.absmax, AREA_TRIGGERS ]
        for [ hit: Edict ] in touch
            if [ !hit.inuse ] continue
            if [ !hit.touch ] continue
            hit.touch[ hit, ent ]

    # ---- gi.soundindex, modelindex, imageindex: names interned
    func name_index [ table: vec string, name: string ] -> i32
        if [ !name ] return 0
        for [ i: i32 1, i < table.count, i += 1 ]
            if [ table[ i ] == name ] return i
        table.push[ name ]
        return table.count - 1

    public func soundindex [ name: string ] -> i32
        return name_index[ sounds, name ]

    public func modelindex [ name: string ] -> i32
        return name_index[ models, name ]

    public func imageindex [ name: string ] -> i32
        return name_index[ images, name ]

    # ---- gi.sound and friends: queued for the client side
    public func sound [ e: Edict, channel: i32, index: i32, volume: f32,
                        attenuation: f32 ]
        if [ index == 0 ] return
        # SV_StartSound: a brush model is heard from its box's middle
        from : vec3f [ 0.0, 0.0, 0.0 ]
        if [ e ] from = e.origin
        if [ e && e.solid == SOLID_BSP ]
            from = v_ma[ from, 0.5, v_add[ e.mins, e.maxs ] ]
        events.push[ GameEvent [ kind: EVENT_SOUND, ent: e,
            origin: from, index: index, channel: channel,
            volume: volume, attenuation: attenuation ] ]

    public func positioned_sound [ origin: vec3f, e: Edict, channel: i32,
                                   index: i32, volume: f32,
                                   attenuation: f32 ]
        if [ index == 0 ] return
        events.push[ GameEvent [ kind: EVENT_SOUND, ent: e,
            origin: origin, index: index, channel: channel,
            volume: volume, attenuation: attenuation ] ]

    # svc_temp_entity: kind, place, direction, count and color
    public func temp_entity [ kind: i32, origin: vec3f, dir: vec3f,
                              count: i32, color: i32 ]
        events.push[ GameEvent [ kind: EVENT_TEMP, index: kind,
            origin: origin, dir: dir, count: count, color: color ] ]

    public func temp_entity_at [ kind: i32, origin: vec3f ]
        temp_entity[ kind, origin, vec3f [ 0.0, 0.0, 0.0 ], 0, 0 ]

    public func temp_entity_dir [ kind: i32, origin: vec3f, dir: vec3f ]
        temp_entity[ kind, origin, dir, 0, 0 ]

    # a two point temp entity (rail trail, bubble trail, laser)
    public func temp_entity_line [ kind: i32, from: vec3f, to: vec3f ]
        events.push[ GameEvent [ kind: EVENT_TEMP, index: kind,
            origin: from, dir: to ] ]

    # a cable from an entity (the parasite's tongue, the medic's)
    public func temp_entity_beam [ kind: i32, e: Edict, from: vec3f,
                                   to: vec3f ]
        events.push[ GameEvent [ kind: EVENT_TEMP, index: kind, ent: e,
            origin: from, dir: to ] ]

    public func muzzleflash [ e: Edict, flash: i32 ]
        events.push[ GameEvent [ kind: EVENT_FLASH, ent: e,
            origin: e.origin, index: flash ] ]

    public func muzzleflash2 [ e: Edict, flash: i32 ]
        events.push[ GameEvent [ kind: EVENT_FLASH2, ent: e,
            origin: e.origin, index: flash ] ]

    # gi.cprintf, centerprintf, bprintf
    public func cprintf [ e: Edict, s: string ]
        dprintf[ s ]
        if [ printed && e ]
            printed.push[ s ]
            printed_to.push[ e.number ]

    public func centerprintf [ e: Edict, s: string ]
        if [ e && e.client ]
            e.client.centerprint = s
            e.client.centerprint_time = level.time + 5.0
        dprintf[ 'centerprint: {s}' ]

    public func bprintf [ s: string ]
        dprintf[ s ]
        if [ printed ]
            everyone : i32 [ 0 ]
            printed.push[ s ]
            printed_to.push[ everyone ]

    # ---- findradius: the next entity whose centre is within rad
    public func findradius [ from: Edict, org: vec3f, rad: f32 ] -> Edict
        i : i32 [ (from) ? from.number + 1 : 0 ]
        while [ i < num_edicts ]
            e : edicts[ i ]
            i += 1
            if [ !e.inuse ] continue
            if [ e.solid == SOLID_NOT ] continue
            eorg : vec3f [ org.x - (e.origin.x + (e.mins.x + e.maxs.x) * 0.5),
                           org.y - (e.origin.y + (e.mins.y + e.maxs.y) * 0.5),
                           org.z - (e.origin.z + (e.mins.z + e.maxs.z) * 0.5) ]
            if [ v_len[ eorg ] > rad ] continue
            return e
        return null

    # KillBox: everything in the entity's box takes a telefrag
    public func kill_box [ e: Edict ] -> bool
        zero : vec3f [ 0.0, 0.0, 0.0 ]
        while [ true ]
            tr : world.trace[ e.origin, e.mins, e.maxs, e.origin, null,
                              MASK_PLAYERSOLID ]
            if [ !tr.ent ] break
            t_damage[ tr.ent, e, e, zero, e.origin, zero, 100000, 0,
                      DAMAGE_NO_PROTECTION, MOD_TELEFRAG ]
            if [ tr.ent.solid != SOLID_NOT ] return false
        return true

    # G_TouchSolids: the solids the box overlaps get a touch
    public func touch_solids [ ent: Edict ]
        touch : world.area_edicts[ ent.absmin, ent.absmax, AREA_SOLID ]
        for [ hit: Edict ] in touch
            if [ !hit.inuse ] continue
            if [ hit.touch ] hit.touch[ hit, ent ]
            if [ !ent.inuse ] break

    # ---- g_phys.c
    func check_velocity [ e: Edict ]
        mx : f32 [ sv_maxvelocity ]
        e.velocity = vec3f [ clamp[ e.velocity.x, 0.0 - mx, mx ],
                             clamp[ e.velocity.y, 0.0 - mx, mx ],
                             clamp[ e.velocity.z, 0.0 - mx, mx ] ]

    # SV_Impact: two entities touched; the trace carries the plane
    func impact [ e: Edict, tr: Trace ]
        other : tr.ent
        if [ e.touch != null && e.solid != SOLID_NOT ]
            touch_plane.fraction = tr.fraction
            touch_plane.nx = tr.nx
            touch_plane.ny = tr.ny
            touch_plane.nz = tr.nz
            touch_plane.ex = tr.ex
            touch_plane.ey = tr.ey
            touch_plane.ez = tr.ez
            touch_plane.ent = tr.ent
            touch_plane.contents = tr.contents
            touch_plane.surf_flags = tr.surf_flags
            touch_plane_on = true
            e.touch[ e, other ]
            touch_plane_on = false
        if [ other && other.touch && other.solid != SOLID_NOT ]
            other.touch[ other, e ]

    # ClipVelocity: slides off the plane; 1 floor, 2 wall or step
    public func clip_velocity [ v: vec3f, normal: vec3f,
                                overbounce: f32 ] -> vec3f
        backoff : f32 [ v_dot[ v, normal ] * overbounce ]
        out : vec3f [ v.x - normal.x * backoff, v.y - normal.y * backoff,
                      v.z - normal.z * backoff ]
        if [ out.x > -0.1 && out.x < 0.1 ] out = vec3f [ 0.0, out.y, out.z ]
        if [ out.y > -0.1 && out.y < 0.1 ] out = vec3f [ out.x, 0.0, out.z ]
        if [ out.z > -0.1 && out.z < 0.1 ] out = vec3f [ out.x, out.y, 0.0 ]
        return out

    # SV_FlyMove: the slide along up to five planes
    func fly_move [ e: Edict, time: f32, mask: i32 ] -> i32
        blocked : i32 [ 0 ]
        original : vec3f [ e.velocity ]
        primal : vec3f [ e.velocity ]
        planes : vec vec3f []
        time_left : f32 [ time ]
        e.groundentity = null
        for [ bump: i32 0, bump < 4, bump += 1 ]
            endp : v_ma[ e.origin, time_left, e.velocity ]
            tr : world.trace[ e.origin, e.mins, e.maxs, endp, e, mask ]
            if [ tr.allsolid ]
                e.velocity = vec3f [ 0.0, 0.0, 0.0 ]
                return 3
            if [ tr.fraction > 0.0 ]
                e.origin = vec3f [ tr.ex, tr.ey, tr.ez ]
                original = e.velocity
                planes = vec vec3f []
            if [ tr.fraction == 1.0 ] break
            hit : tr.ent
            if [ tr.nz > 0.7 ]
                blocked = blocked | 1
                if [ hit.solid == SOLID_BSP ]
                    e.groundentity = hit
                    e.groundentity_linkcount = hit.linkcount
            if [ tr.nz == 0.0 ] blocked = blocked | 2
            impact[ e, tr ]
            if [ !e.inuse ] break
            time_left = time_left - time_left * tr.fraction
            if [ planes.count >= 5 ]
                e.velocity = vec3f [ 0.0, 0.0, 0.0 ]
                return 3
            planes.push[ vec3f [ tr.nx, tr.ny, tr.nz ] ]
            n : i32 [ planes.count ]
            i : i32 [ 0 ]
            fresh : vec3f [ e.velocity ]
            while [ i < n ]
                fresh = clip_velocity[ original, planes[ i ], 1.0 ]
                j : i32 [ 0 ]
                while [ j < n ]
                    if [ j != i && !v_eq[ planes[ i ], planes[ j ] ] ]
                        if [ v_dot[ fresh, planes[ j ] ] < 0.0 ] break
                    j += 1
                if [ j == n ] break
                i += 1
            if [ i != n ]
                e.velocity = fresh
            el
                if [ n != 2 ]
                    e.velocity = vec3f [ 0.0, 0.0, 0.0 ]
                    return 7
                dir : v_cross[ planes[ 0 ], planes[ 1 ] ]
                e.velocity = v_scale[ dir, v_dot[ dir, e.velocity ] ]
            if [ v_dot[ e.velocity, primal ] <= 0.0 ]
                e.velocity = vec3f [ 0.0, 0.0, 0.0 ]
                return blocked
        return blocked

    public func add_gravity [ e: Edict ]
        e.velocity = vec3f [ e.velocity.x, e.velocity.y,
            e.velocity.z - e.gravity * sv_gravity * FRAMETIME ]

    # SV_PushEntity: moved by push, touching what it hits
    func push_entity [ e: Edict, push: vec3f ] -> Trace
        start : vec3f [ e.origin ]
        endp : v_add[ start, push ]
        mask : i32 [ (e.clipmask != 0) ? e.clipmask : MASK_SOLID ]
        tr : world.trace[ start, e.mins, e.maxs, endp, e, mask ]
        while [ true ]
            tr = world.trace[ start, e.mins, e.maxs, endp, e, mask ]
            e.origin = vec3f [ tr.ex, tr.ey, tr.ez ]
            world.link[ e ]
            if [ tr.fraction != 1.0 ]
                impact[ e, tr ]
                # what it hit went away: the move again
                if [ tr.ent && !tr.ent.inuse && e.inuse ]
                    e.origin = start
                    world.link[ e ]
                    continue
            break
        if [ e.inuse ] touch_triggers[ e ]
        return tr

    # SV_Physics_Toss: toss, bounce and fly; still on the ground
    func physics_toss [ e: Edict ]
        run_think[ e ]
        if [ e.flags & FL_TEAMSLAVE ] return
        if [ e.velocity.z > 0.0 ] e.groundentity = null
        if [ e.groundentity && !e.groundentity.inuse ] e.groundentity = null
        if [ e.groundentity ] return
        old_origin : vec3f [ e.origin ]
        check_velocity[ e ]
        if [ e.movetype != MOVETYPE_FLY && e.movetype != MOVETYPE_FLYMISSILE ]
            add_gravity[ e ]
        e.angles = v_ma[ e.angles, FRAMETIME, e.avelocity ]
        move : v_scale[ e.velocity, FRAMETIME ]
        tr : push_entity[ e, move ]
        if [ !e.inuse ] return
        if [ tr.fraction < 1.0 ]
            backoff : f32 [ (e.movetype == MOVETYPE_BOUNCE) ? 1.5 : 1.0 ]
            normal : vec3f [ tr.nx, tr.ny, tr.nz ]
            e.velocity = clip_velocity[ e.velocity, normal, backoff ]
            # stopped on a floor
            if [ tr.nz > 0.7 ]
                if [ e.velocity.z < 60.0 || e.movetype != MOVETYPE_BOUNCE ]
                    e.groundentity = tr.ent
                    e.groundentity_linkcount = tr.ent.linkcount
                    e.velocity = vec3f [ 0.0, 0.0, 0.0 ]
                    e.avelocity = vec3f [ 0.0, 0.0, 0.0 ]
        wasinwater : bool [ (e.watertype & MASK_WATER) != 0 ]
        e.watertype = world.point_contents[ e.origin ]
        isinwater : bool [ (e.watertype & MASK_WATER) != 0 ]
        e.waterlevel = (isinwater) ? 1 : 0
        if [ !wasinwater && isinwater ]
            positioned_sound[ old_origin, edicts[ 0 ], CHAN_AUTO,
                soundindex[ 'misc/h2ohit1.wav' ], 1.0, 1.0 ]
        el [ wasinwater && !isinwater ]
            positioned_sound[ e.origin, edicts[ 0 ], CHAN_AUTO,
                soundindex[ 'misc/h2ohit1.wav' ], 1.0, 1.0 ]
        slave : e.teamchain
        while [ slave ]
            slave.origin = e.origin
            world.link[ slave ]
            slave = slave.teamchain

    func add_rotational_friction [ e: Edict ]
        e.angles = v_ma[ e.angles, FRAMETIME, e.avelocity ]
        adjustment : f32 [ FRAMETIME * 100.0 * 6.0 ]
        e.avelocity = vec3f [ friction_toward_zero[ e.avelocity.x, adjustment ],
                              friction_toward_zero[ e.avelocity.y, adjustment ],
                              friction_toward_zero[ e.avelocity.z, adjustment ] ]

    func friction_toward_zero [ v: f32, adjustment: f32 ] -> f32
        if [ v > 0.0 ]
            r : f32 [ v - adjustment ]
            return (r < 0.0) ? 0.0 : r
        r : f32 [ v + adjustment ]
        return (r > 0.0) ? 0.0 : r

    # SV_Physics_Step: monsters fall free, else move in steps
    func physics_step [ e: Edict ]
        hitsound : bool [ false ]
        if [ !e.groundentity ] m_check_ground[ e ]
        groundentity : e.groundentity
        check_velocity[ e ]
        wasonground : bool [ groundentity ]
        if [ !v_zero[ e.avelocity ] ] add_rotational_friction[ e ]
        if [ !wasonground && (e.flags & FL_FLY) == 0 &&
             !((e.flags & FL_SWIM) != 0 && e.waterlevel > 2) ]
            if [ e.velocity.z < sv_gravity * -0.1 ] hitsound = true
            if [ e.waterlevel == 0 ] add_gravity[ e ]
        # friction for flying monsters that have been given vertical velocity
        if [ (e.flags & FL_FLY) != 0 && e.velocity.z != 0.0 ]
            speed : f32 [ fabs[ e.velocity.z ] ]
            control : f32 [ (speed < 100.0) ? 100.0 : speed ]
            newspeed : f32 [ speed - FRAMETIME * control * 2.0 ]
            if [ newspeed < 0.0 ] newspeed = 0.0
            e.velocity = vec3f [ e.velocity.x, e.velocity.y,
                                 e.velocity.z * (newspeed / speed) ]
        # friction for swimming monsters that have been given vertical velocity
        if [ (e.flags & FL_SWIM) != 0 && e.velocity.z != 0.0 ]
            speed : f32 [ fabs[ e.velocity.z ] ]
            control : f32 [ (speed < 100.0) ? 100.0 : speed ]
            newspeed : f32 [ speed - FRAMETIME * control * 1.0
                             * f32[ e.waterlevel ] ]
            if [ newspeed < 0.0 ] newspeed = 0.0
            e.velocity = vec3f [ e.velocity.x, e.velocity.y,
                                 e.velocity.z * (newspeed / speed) ]
        if [ !v_zero[ e.velocity ] ]
            # apply friction: let dead monsters who aren't completely
            # onground slide
            if [ wasonground || (e.flags & (FL_SWIM | FL_FLY)) != 0 ]
                if [ !(e.health <= 0 && !m_check_bottom[ e ]) ]
                    speed : f32 [ sqrt[ e.velocity.x * e.velocity.x
                                        + e.velocity.y * e.velocity.y ] ]
                    if [ speed != 0.0 ]
                        control : f32 [ (speed < 100.0) ? 100.0 : speed ]
                        newspeed : f32 [ speed - FRAMETIME * control * 6.0 ]
                        if [ newspeed < 0.0 ] newspeed = 0.0
                        newspeed = newspeed / speed
                        e.velocity = vec3f [ e.velocity.x * newspeed,
                                             e.velocity.y * newspeed,
                                             e.velocity.z ]
            mask : i32 [ (e.svflags & SVF_MONSTER) ? MASK_MONSTERSOLID
                         : MASK_SOLID ]
            fly_move[ e, FRAMETIME, mask ]
            world.link[ e ]
            touch_triggers[ e ]
            if [ !e.inuse ] return
            if [ e.groundentity && !wasonground && hitsound ]
                sound[ e, 0, soundindex[ 'world/land.wav' ], 1.0, 1.0 ]
        run_think[ e ]

    # ---- the entity string: COM_Parse over the lump text
    func parse_token [ s: cstr, pos: vec i32 ] -> string
        i : i32 [ pos[ 0 ] ]
        if [ i < 0 ] return null
        while [ true ]
            while [ s[ i ] != 0 && i32[ s[ i ] ] <= 32 ] i += 1
            if [ s[ i ] == 0 ]
                pos[ 0 ] = -1
                return null
            if [ s[ i ] == 47 && s[ i + 1 ] == 47 ]
                while [ s[ i ] != 0 && s[ i ] != 10 ] i += 1
                continue
            break
        buf : local i8 [ 1024 ]
        n : i32 [ 0 ]
        if [ s[ i ] == 34 ]
            i += 1
            while [ s[ i ] != 0 && s[ i ] != 34 ]
                if [ n < 1023 ]
                    buf[ n ] = s[ i ]
                    n += 1
                i += 1
            if [ s[ i ] == 34 ] i += 1
        el
            while [ i32[ s[ i ] ] > 32 ]
                if [ n < 1023 ]
                    buf[ n ] = s[ i ]
                    n += 1
                i += 1
        buf[ n ] = 0
        pos[ 0 ] = i
        return string [ cast cstr [ buf ] ]

    func parse_vec [ v: string ] -> vec3f
        x : f32 [ 0.0 ]
        y : f32 [ 0.0 ]
        z : f32 [ 0.0 ]
        sscanf[ v.chars, "%f %f %f", @x, @y, @z ]
        return vec3f [ x, y, z ]

    # ED_ParseField: the fields table of g_save.c
    # ED_NewString: a written backslash n is a line break
    func new_string [ v: string ] -> string
        buf : local i8 [ 1024 ]
        n : i32 [ 0 ]
        i : i32 [ 0 ]
        while [ i < v.count && n < 1023 ]
            c : i32 [ v[ i ] ]
            if [ c == 92 && i + 1 < v.count ]
                i += 1
                c = (v[ i ] == 110) ? 10 : 92
            buf[ n ] = c
            n += 1
            i += 1
        buf[ n ] = 0
        return string [ cast cstr [ buf ] ]

    func parse_field [ key: string, v: string, e: Edict ]
        k : string [ key ]
        if [ k == 'classname' ]    e.classname = v
        el [ k == 'model' ]        e.model = v
        el [ k == 'spawnflags' ]   e.spawnflags = atoi[ v.chars ]
        el [ k == 'speed' ]        e.speed = atof[ v.chars ]
        el [ k == 'accel' ]        e.accel = atof[ v.chars ]
        el [ k == 'decel' ]        e.decel = atof[ v.chars ]
        el [ k == 'target' ]       e.target = v
        el [ k == 'targetname' ]   e.targetname = v
        el [ k == 'pathtarget' ]   e.pathtarget = v
        el [ k == 'deathtarget' ]  e.deathtarget = v
        el [ k == 'killtarget' ]   e.killtarget = v
        el [ k == 'combattarget' ] e.combattarget = v
        el [ k == 'message' ]      e.message = new_string[ v ]
        el [ k == 'team' ]         e.team = v
        el [ k == 'wait' ]         e.wait = atof[ v.chars ]
        el [ k == 'delay' ]        e.delay = atof[ v.chars ]
        el [ k == 'random' ]       e.random = atof[ v.chars ]
        el [ k == 'move_origin' ]  e.move_origin = parse_vec[ v ]
        el [ k == 'move_angles' ]  e.move_angles = parse_vec[ v ]
        el [ k == 'style' ]        e.style = atoi[ v.chars ]
        el [ k == 'count' ]        e.count = atoi[ v.chars ]
        el [ k == 'health' ]       e.health = atoi[ v.chars ]
        el [ k == 'sounds' ]       e.sounds = atoi[ v.chars ]
        el [ k == 'dmg' ]          e.dmg = atoi[ v.chars ]
        el [ k == 'mass' ]         e.mass = atoi[ v.chars ]
        el [ k == 'volume' ]       e.volume = atof[ v.chars ]
        el [ k == 'attenuation' ]  e.attenuation = atof[ v.chars ]
        el [ k == 'map' ]          e.map = v
        el [ k == 'origin' ]       e.origin = parse_vec[ v ]
        el [ k == 'angles' ]       e.angles = parse_vec[ v ]
        el [ k == 'angle' ]        e.angles = vec3f [ 0.0, atof[ v.chars ], 0.0 ]
        el [ k == 'lip' ]          st.lip = atoi[ v.chars ]
        el [ k == 'distance' ]     st.distance = atoi[ v.chars ]
        el [ k == 'height' ]       st.height = atoi[ v.chars ]
        el [ k == 'noise' ]        st.noise = v
        el [ k == 'pausetime' ]    st.pausetime = atof[ v.chars ]
        el [ k == 'item' ]         st.item = v
        el [ k == 'gravity' ]      st.gravity = v
        el [ k == 'sky' ]          st.sky = v
        el [ k == 'skyrotate' ]    st.skyrotate = atof[ v.chars ]
        el [ k == 'skyaxis' ]      st.skyaxis = parse_vec[ v ]
        el [ k == 'minyaw' ]       st.minyaw = atof[ v.chars ]
        el [ k == 'maxyaw' ]       st.maxyaw = atof[ v.chars ]
        el [ k == 'minpitch' ]     st.minpitch = atof[ v.chars ]
        el [ k == 'maxpitch' ]     st.maxpitch = atof[ v.chars ]
        el [ k == 'nextmap' ]      st.nextmap = v
        el [ k == 'light' ]        return
        el
            dprintf[ '{k} is not a field' ]

    # ED_ParseEdict: the key pairs up to the closing brace
    func parse_edict [ s: cstr, pos: vec i32, e: Edict ]
        st = SpawnTemp [ ]
        while [ true ]
            key : parse_token[ s, pos ]
            if [ !key ] return
            if [ key.count == 1 && key[ 0 ] == 125 ] return
            v : parse_token[ s, pos ]
            if [ !v ] return
            if [ v.count == 1 && v[ 0 ] == 125 ]
                dprintf[ 'ED_ParseEntity: closing brace without data' ]
                return
            if [ key[ 0 ] == 95 ] continue
            parse_field[ key, v, e ]

    # SpawnEntities
    func spawn_entities [ mapname: string, entities: string ]
        level.mapname = mapname
        s : cstr [ entities.chars ]
        pos : vec i32 [] [ 0 ]
        inhibit : i32 [ 0 ]
        first : bool [ true ]
        while [ true ]
            tok : parse_token[ s, pos ]
            if [ !tok ] break
            if [ tok.count != 1 || tok[ 0 ] != 123 ]
                dprintf[ 'ED_LoadFromFile: found {tok} when expecting a brace' ]
                break
            e : Edict [ null ]
            if [ first ]
                e = edicts[ 0 ]
                first = false
            el
                e = spawn[]
            parse_edict[ s, pos, e ]
            if [ e.number != 0 ]
                nope : bool [ false ]
                if [ deathmatch ]
                    nope = (e.spawnflags & SPAWNFLAG_NOT_DEATHMATCH) != 0
                el
                    if [ skill == 0 ]
                        nope = (e.spawnflags & SPAWNFLAG_NOT_EASY) != 0
                    if [ skill == 1 ]
                        nope = (e.spawnflags & SPAWNFLAG_NOT_MEDIUM) != 0
                    if [ skill >= 2 ]
                        nope = (e.spawnflags & SPAWNFLAG_NOT_HARD) != 0
                if [ nope ]
                    free_edict[ e ]
                    inhibit += 1
                    continue
                e.spawnflags = e.spawnflags & ~(SPAWNFLAG_NOT_EASY |
                    SPAWNFLAG_NOT_MEDIUM | SPAWNFLAG_NOT_HARD |
                    SPAWNFLAG_NOT_COOP | SPAWNFLAG_NOT_DEATHMATCH)
            call_spawn[ e ]
        dprintf[ '{inhibit} entities inhibited' ]
        find_teams[]
        dprintf[ '{num_edicts} edicts' ]

    # G_FindTeams: teammaster and teamchain by the team key
    func find_teams []
        c : i32 [ 0 ]
        c2 : i32 [ 0 ]
        for [ i: i32 1, i < num_edicts, i += 1 ]
            e : edicts[ i ]
            if [ !e.inuse ] continue
            if [ !e.team ] continue
            if [ e.flags & FL_TEAMSLAVE ] continue
            chain : e
            e.teammaster = e
            c += 1
            c2 += 1
            for [ j: i32 i + 1, j < num_edicts, j += 1 ]
                e2 : edicts[ j ]
                if [ !e2.inuse ] continue
                if [ !e2.team ] continue
                if [ e2.flags & FL_TEAMSLAVE ] continue
                if [ e.team == e2.team ]
                    c2 += 1
                    chain.teamchain = e2
                    e2.teammaster = e
                    chain = e2
                    e2.flags = e2.flags | FL_TEAMSLAVE
        dprintf[ '{c} teams with {c2} entities' ]

    # ED_CallSpawn: the spawn table
    public func call_spawn [ e: Edict ]
        c : string [ e.classname ]
        if [ !c ]
            dprintf[ 'ED_CallSpawn: NULL classname' ]
            return
        if [ c == 'worldspawn' ]       sp_worldspawn[ e ]
        el [ c == 'misc_ctf_banner' ]  sp_misc_ctf_banner[ e, false ]
        el [ c == 'misc_ctf_small_banner' ]
            sp_misc_ctf_banner[ e, true ]
        el [ c == 'trigger_teleport' ] sp_trigger_teleport[ e ]
        el [ c == 'info_player_team1' || c == 'info_player_team2' ]
            e.solid = SOLID_NOT
        el [ c == 'info_teleport_destination' ]
            sp_info_teleport_destination[ e ]
        el [ c == 'func_door' ]        sp_func_door[ e ]
        el [ c == 'func_plat' ]        sp_func_plat[ e ]
        el [ c == 'func_button' ]      sp_func_button[ e ]
        el [ c == 'func_train' ]       sp_func_train[ e ]
        el [ c == 'path_corner' ]      sp_path_corner[ e ]
        el [ c == 'func_rotating' ]    sp_func_rotating[ e ]
        el [ c == 'func_water' ]       sp_func_water[ e ]
        el [ c == 'trigger_elevator' ] sp_trigger_elevator[ e ]
        el [ c == 'func_timer' ]       sp_func_timer[ e ]
        el [ c == 'func_conveyor' ]    sp_func_conveyor[ e ]
        el [ c == 'func_door_secret' ] sp_func_door_secret[ e ]
        el [ c == 'func_killbox' ]     sp_func_killbox[ e ]
        el [ c == 'func_wall' ]        sp_func_wall[ e ]
        el [ c == 'func_object' ]      sp_func_object[ e ]
        el [ c == 'func_explosive' ]   sp_func_explosive[ e ]
        el [ c == 'trigger_key' ]      sp_trigger_key[ e ]
        el [ c == 'trigger_counter' ]  sp_trigger_counter[ e ]
        el [ c == 'trigger_always' ]   sp_trigger_always[ e ]
        el [ c == 'trigger_push' ]     sp_trigger_push[ e ]
        el [ c == 'trigger_hurt' ]     sp_trigger_hurt[ e ]
        el [ c == 'trigger_gravity' ]  sp_trigger_gravity[ e ]
        el [ c == 'trigger_monsterjump' ] sp_trigger_monsterjump[ e ]
        el [ c == 'target_temp_entity' ] sp_target_temp_entity[ e ]
        el [ c == 'target_speaker' ]   sp_target_speaker[ e ]
        el [ c == 'target_help' ]      sp_target_help[ e ]
        el [ c == 'target_secret' ]    sp_target_secret[ e ]
        el [ c == 'target_goal' ]      sp_target_goal[ e ]
        el [ c == 'target_explosion' ] sp_target_explosion[ e ]
        el [ c == 'target_changelevel' ] sp_target_changelevel[ e ]
        el [ c == 'target_splash' ]    sp_target_splash[ e ]
        el [ c == 'target_spawner' ]   sp_target_spawner[ e ]
        el [ c == 'target_blaster' ]   sp_target_blaster[ e ]
        el [ c == 'target_crosslevel_trigger' ]
            sp_target_crosslevel_trigger[ e ]
        el [ c == 'target_crosslevel_target' ]
            sp_target_crosslevel_target[ e ]
        el [ c == 'target_laser' ]     sp_target_laser[ e ]
        el [ c == 'target_lightramp' ] sp_target_lightramp[ e ]
        el [ c == 'target_earthquake' ] sp_target_earthquake[ e ]
        el [ c == 'func_door_rotating' ] sp_func_door_rotating[ e ]
        el [ c == 'func_areaportal' ]  sp_func_areaportal[ e ]
        el [ c == 'trigger_once' ]     sp_trigger_once[ e ]
        el [ c == 'trigger_multiple' ] sp_trigger_multiple[ e ]
        el [ c == 'trigger_relay' ]    sp_trigger_relay[ e ]
        el [ c == 'info_null' || c == 'func_group' ] free_edict[ e ]
        el [ c == 'item_health' ]      sp_item_health[ e ]
        el [ c == 'item_health_small' ] sp_item_health_small[ e ]
        el [ c == 'item_health_large' ] sp_item_health_large[ e ]
        el [ c == 'item_health_mega' ] sp_item_health_mega[ e ]
        el [ find_item_by_classname[ c ] ]
            spawn_item[ e, find_item_by_classname[ c ] ]
        el [ spawn_class[ c, e ] ]
            return
        el
            # brush entities not yet ported stay solid where they are
            if [ e.model && e.model[ 0 ] == 42 ]
                sp_static_bmodel[ e ]
            el
                e.solid = SOLID_NOT
            unknown_class[ c ]

    func unknown_class [ c: string ]
        for [ u: string ] in unknown
            if [ u == c ] return
        unknown.push[ c ]
        dprintf[ '{c} not ported yet' ]

    # SP_worldspawn, the parts without the server's configstrings
    func sp_worldspawn [ e: Edict ]
        e.movetype = MOVETYPE_PUSH
        e.solid = SOLID_BSP
        e.inuse = true
        e.modelindex = 1
        if [ st.nextmap ] level.nextmap = st.nextmap
        level.level_name = (e.message) ? e.message : level.mapname

    func sp_info_player_start [ e: Edict ]
        e.solid = SOLID_NOT

    # SP_light: a light with no targetname is free at load
    func sp_light [ e: Edict ]
        if [ !e.targetname ] free_edict[ e ]

    # a brush entity whose class is not ported: a wall for now
    func sp_static_bmodel [ e: Edict ]
        e.movetype = MOVETYPE_PUSH
        e.solid = SOLID_BSP
        # a mover's angle key is its direction, never a turn
        e.angles = vec3f [ 0.0, 0.0, 0.0 ]
        setmodel[ e, e.model ]

    # ---- triggers (g_trigger.c)
    # CS_LIGHTS style strings: one letter kept per style
    public func set_lightstyle [ style: i32, letter: i32 ]
        if [ style < 0 || style >= 64 ] return
        lightstyles[ style ] = letter

    public func set_areaportal [ portal: i32, open: bool ]
        if [ portal >= 0 && portal < portal_open.count ]
            portal_open[ portal ] = open
            # CM_SetAreaPortalState
            bsp.flood_areas[ portal_open ]

    # SV_RunThink: false when the entity thought this frame
    func run_think [ e: Edict ] -> bool
        t : f32 [ e.nextthink ]
        if [ t <= 0.0 ] return true
        if [ t > level.time + 0.001 ] return true
        e.nextthink = 0.0
        if [ !e.think ]
            dprintf[ 'NULL ent->think on {e.classname}' ]
            return false
        e.think[ e ]
        return false

    # SV_TestEntityPosition: the world when the box sits in solid
    func test_entity_position [ e: Edict ] -> Edict
        mask : i32 [ (e.clipmask != 0) ? e.clipmask : MASK_SOLID ]
        t : world.trace[ e.origin, e.mins, e.maxs, e.origin, e, mask ]
        if [ t.startsolid ] return edicts[ 0 ]
        return null

    # SV_Push: move the pusher, carry or push what it meets
    func push [ pusher: Edict, move_in: vec3f, amove: vec3f ] -> bool
        # the move to 1/8 units, as the client predicts
        mv : vec3f [ move_in ]
        mx : f32 [ mv.x * 8.0 ]
        my : f32 [ mv.y * 8.0 ]
        mz : f32 [ mv.z * 8.0 ]
        mx = (mx > 0.0) ? mx + 0.5 : mx - 0.5
        my = (my > 0.0) ? my + 0.5 : my - 0.5
        mz = (mz > 0.0) ? mz + 0.5 : mz - 0.5
        move : vec3f [ 0.125 * f32[ i32[ mx ] ], 0.125 * f32[ i32[ my ] ],
                       0.125 * f32[ i32[ mz ] ] ]
        mins : v_add[ pusher.absmin, move ]
        maxs : v_add[ pusher.absmax, move ]
        ax : angle_vectors[ v_neg[ amove ] ]
        pushed.push[ Pushed [ ent: pusher, origin: pusher.origin,
                              angles: pusher.angles ] ]
        pusher.origin = v_add[ pusher.origin, move ]
        pusher.angles = v_add[ pusher.angles, amove ]
        world.link[ pusher ]
        for [ ei: i32 1, ei < num_edicts, ei += 1 ]
            check : edicts[ ei ]
            if [ !check.inuse ] continue
            if [ check.movetype == MOVETYPE_PUSH ||
                 check.movetype == MOVETYPE_STOP ||
                 check.movetype == MOVETYPE_NONE ||
                 check.movetype == MOVETYPE_NOCLIP ]
                continue
            if [ !check.linked ] continue
            if [ check.groundentity != pusher ]
                if [ check.absmin.x >= maxs.x || check.absmin.y >= maxs.y ||
                     check.absmin.z >= maxs.z || check.absmax.x <= mins.x ||
                     check.absmax.y <= mins.y || check.absmax.z <= mins.z ]
                    continue
                if [ !test_entity_position[ check ] ] continue
            if [ pusher.movetype == MOVETYPE_PUSH ||
                 check.groundentity == pusher ]
                pushed.push[ Pushed [ ent: check, origin: check.origin,
                                      angles: check.angles ] ]
                check.origin = v_add[ check.origin, move ]
                # the turn of the pusher moves a rider round it
                org : v_sub[ check.origin, pusher.origin ]
                org2 : vec3f [ v_dot[ org, ax.forward ],
                               0.0 - v_dot[ org, ax.right ],
                               v_dot[ org, ax.up ] ]
                check.origin = v_add[ check.origin, v_sub[ org2, org ] ]
                if [ check.groundentity != pusher ]
                    check.groundentity = null
                block : test_entity_position[ check ]
                if [ !block ]
                    world.link[ check ]
                    continue
                # a rider may stay where it was
                check.origin = v_sub[ check.origin, move ]
                block = test_entity_position[ check ]
                if [ !block ]
                    pushed.pop[]
                    continue
            obstacle = check
            # back every moved entity out, last first
            for [ k: i32 pushed.count - 1, k >= 0, k = k - 1 ]
                p : pushed[ k ]
                p.ent.origin = p.origin
                p.ent.angles = p.angles
                world.link[ p.ent ]
            return false
        for [ k: i32 pushed.count - 1, k >= 0, k = k - 1 ]
            p : pushed[ k ]
            touch_triggers[ p.ent ]
        return true

    # SV_Physics_Pusher: the whole team moves, or none of it
    func physics_pusher [ ent: Edict ]
        if [ ent.flags & FL_TEAMSLAVE ] return
        pushed = vec Pushed []
        part : ent
        while [ part ]
            if [ !v_zero[ part.velocity ] || !v_zero[ part.avelocity ] ]
                move  : v_scale[ part.velocity, FRAMETIME ]
                amove : v_scale[ part.avelocity, FRAMETIME ]
                if [ !push[ part, move, amove ] ] break
            part = part.teamchain
        if [ part ]
            mv : ent
            while [ mv ]
                if [ mv.nextthink > 0.0 ] mv.nextthink += FRAMETIME
                mv = mv.teamchain
            if [ part.blocked ] part.blocked[ part, obstacle ]
        el
            part = ent
            while [ part ]
                run_think[ part ]
                part = part.teamchain

    func physics_noclip [ e: Edict ]
        if [ !run_think[ e ] ] return
        e.angles = v_ma[ e.angles, FRAMETIME, e.avelocity ]
        e.origin = v_ma[ e.origin, FRAMETIME, e.velocity ]
        world.link[ e ]

    # G_RunEntity
    func run_entity [ e: Edict ]
        if [ e.prethink ] e.prethink[ e ]
        m : i32 [ e.movetype ]
        if [ m == MOVETYPE_PUSH || m == MOVETYPE_STOP ]
            physics_pusher[ e ]
        el [ m == MOVETYPE_NONE ]
            run_think[ e ]
        el [ m == MOVETYPE_NOCLIP ]
            physics_noclip[ e ]
        el [ m == MOVETYPE_STEP ]
            physics_step[ e ]
        el [ m == MOVETYPE_TOSS || m == MOVETYPE_BOUNCE ||
             m == MOVETYPE_FLY || m == MOVETYPE_FLYMISSILE ]
            physics_toss[ e ]
        el
            # walk: the client's own pmove moves it
            run_think[ e ]

    # G_RunFrame: one tenth of a second of the world
    public func run_frame []
        level.framenum += 1
        level.time = f32[ level.framenum ] * FRAMETIME
        # choose a client for monsters to target this frame
        ai_set_sight_client[]
        check_dm_rules[]
        # exit intermissions
        if [ level.exitintermission ]
            exit_level[]
            return
        for [ i: i32 0, i < num_edicts, i += 1 ]
            e : edicts[ i ]
            if [ !e.inuse ] continue
            level.current_entity = e
            e.old_origin = e.origin
            # if the ground entity moved, make sure we are still on it
            if [ e.groundentity &&
                 e.groundentity.linkcount != e.groundentity_linkcount ]
                e.groundentity = null
                if [ (e.flags & (FL_SWIM | FL_FLY)) == 0 &&
                     (e.svflags & SVF_MONSTER) != 0 ]
                    m_check_ground[ e ]
            if [ i > 0 && i <= maxclients ]
                client_begin_server_frame[ e ]
                continue
            run_entity[ e ]
        # build the playerstate_t structures for all players
        for [ i: i32 1, i <= maxclients, i += 1 ]
            e : edicts[ i ]
            if [ !e.inuse || !e.client ] continue
            client_end_server_frame[ e ]

# the one game; every free function of the game folder reaches it
g : Game
