# cl_scrn.c's status bar: the layout program, drawn with pics
extend quake2

# the single player status bar of g_spawn.c
func hud_statusbar [] -> string
    return 'yb -24 xv 0 hnum xv 50 pic 0 if 2 xv 100 anum xv 150 pic 2 endif if 4 xv 200 rnum xv 250 pic 4 endif if 6 xv 296 pic 6 endif yb -50 if 7 xv 0 pic 7 xv 26 yb -42 stat_string 8 yb -50 endif if 9 xv 262 num 2 10 xv 296 pic 9 endif if 11 xv 148 pic 11 endif'

class Hud
    public md2   : Md2Set
    public names : vec string
    # each name's place in pics, -1 when its file is missing
    public slots : vec i32
    public pics  : vec Texture
    # each pic's width and height
    public sizes : vec i32
    # one pixel of the 320 x 240 layout in ours
    public scale : f32
    # the layout's pen and the screen's size, layout pixels
    public x     : f32
    public y     : f32
    public wide  : f32
    public high  : f32

    func init []
        names = vec string []
        slots = vec i32 []
        pics  = vec Texture []
        sizes = vec i32 []

    # Draw_FindPic: pics/<name>.pcx, loaded once; -1 when missing
    public func find [ cv: Canvas, w: Window, name: string ] -> i32
        for [ i: i32 0, i < names.count, i += 1 ]
            if [ names[ i ] == name ] return slots[ i ]
        t : md2.load_pcx[ 'pics/{name}.pcx', true ]
        names.push[ name ]
        if [ !t ]
            none : i32 [ -1 ]
            slots.push[ none ]
            return none
        img : Image [ width: t.width, height: t.height,
                      format: Pixel.rgba8, linear: true ]
        px : @u8 [ img.vdata[] ]
        n : i32 [ t.width * t.height ]
        for [ i: i32 0, i < n, i += 1 ]
            # the canvas wants colour times alpha: clear is black
            solid : bool [ t.pixels[ i * 4 + 3 ] != 0 ]
            px[ i * 4 ]     = (solid) ? t.pixels[ i * 4 ] : 0
            px[ i * 4 + 1 ] = (solid) ? t.pixels[ i * 4 + 1 ] : 0
            px[ i * 4 + 2 ] = (solid) ? t.pixels[ i * 4 + 2 ] : 0
            px[ i * 4 + 3 ] = t.pixels[ i * 4 + 3 ]
        pics.push[ Texture [ vk: cv.vk, w: w, sampler: img,
                             mip_levels: 1, linear: true,
                             nearest: true ] ]
        sizes.push[ t.width ]
        sizes.push[ t.height ]
        slot : i32 [ pics.count - 1 ]
        slots.push[ slot ]
        return slot

    # re.DrawPic at the pen
    public func pic [ cv: Canvas, w: Window, name: string, px: f32, py: f32 ]
        i : i32 [ find[ cv, w, name ] ]
        if [ i < 0 ] return
        cv.draw_image[ pics[ i ],
            rect [ x: px * scale, y: py * scale,
                   w: f32[ sizes[ i * 2 ] ] * scale,
                   h: f32[ sizes[ i * 2 + 1 ] ] * scale ] ]

    # SCR_DrawField: a number right aligned in 16 pixel digits
    func field [ cv: Canvas, w: Window, color: i32, width_in: i32,
                 value: i32 ]
        width : i32 [ (width_in > 5) ? 5 : width_in ]
        if [ width < 1 ] return
        digits : '{value}'
        l : i32 [ (digits.count > width) ? width : digits.count ]
        px : f32 [ x + 2.0 + 16.0 * f32[ width - l ] ]
        base : 'num_'
        if [ color != 0 ] base = 'anum_'
        for [ i: i32 0, i < l, i += 1 ]
            c : i32 [ digits[ i ] ]
            digit : i32 [ c - 48 ]
            name : '{base}{digit}'
            if [ c == 45 ] name = '{base}minus'
            pic[ cv, w, name, px, y ]
            px = px + 16.0

    # re.DrawChar: one 8 pixel cell of pics/conchars.pcx
    public func glyph [ cv: Canvas, w: Window, num: i32, px: f32, py: f32 ]
        code : i32 [ num & 255 ]
        if [ (code & 127) == 32 ] return
        i : i32 [ find[ cv, w, 'conchars' ] ]
        if [ i < 0 ] return
        left : f32 [ f32[ code & 15 ] * 0.0625 ]
        top : f32 [ f32[ code >> 4 ] * 0.0625 ]
        cv.draw_image_crop[ pics[ i ],
            rect [ x: px * scale, y: py * scale, w: 8.0 * scale,
                   h: 8.0 * scale ],
            left, top, left + 0.0625, top + 0.0625 ]

    # DrawString / DrawAltString: alt is the green letters
    public func chars [ cv: Canvas, w: Window, s: string, px: f32,
                        py: f32, alt: bool ]
        for [ i: i32 0, i < s.count, i += 1 ]
            c : i32 [ s[ i ] ]
            if [ alt ] c = c ^ 128
            glyph[ cv, w, c, px + 8.0 * f32[ i ], py ]

    # DrawHUDString: each line centred in 320 pixels, green
    func centered [ cv: Canvas, w: Window, s: string, px: f32,
                    py: f32 ]
        if [ !s ] return
        lines : s.split[ '\n' ]
        for [ i: i32 0, i < lines.count, i += 1 ]
            l : lines[ i ]
            chars[ cv, w, l, px + (320.0 - 8.0 * f32[ l.count ]) / 2.0,
                   py + 8.0 * f32[ i ], true ]

    # a number right aligned in a field of spaces
    func padded [ value: i32, width: i32 ] -> string
        digits : '{value}'
        while [ digits.count < width ] digits = ' {digits}'
        return digits

    # p_hud.c HelpComputer's layout, drawn straight
    public func help [ cv: Canvas, w: Window ]
        left : f32 [ wide / 2.0 - 160.0 ]
        top : f32 [ high / 2.0 - 120.0 ]
        pic[ cv, w, 'help', left + 32.0, top + 8.0 ]
        level : g.level
        sk : 'hard+'
        if [ g.skill == 0 ]      sk = 'easy'
        el [ g.skill == 1 ]      sk = 'medium'
        el [ g.skill == 2 ]      sk = 'hard'
        chars[ cv, w, sk, left + 202.0, top + 12.0, true ]
        centered[ cv, w, level.level_name, left, top + 24.0 ]
        centered[ cv, w, g.helpmessage1, left, top + 54.0 ]
        centered[ cv, w, g.helpmessage2, left, top + 110.0 ]
        chars[ cv, w, ' kills     goals    secrets', left + 50.0,
               top + 164.0, true ]
        kills : padded[ level.killed_monsters, 3 ]
        of_kills : padded[ level.total_monsters, 3 ]
        counts : '{kills}/{of_kills}     {level.found_goals}/{level.total_goals}       {level.found_secrets}/{level.total_secrets}'
        chars[ cv, w, counts, left + 50.0, top + 172.0, true ]

    # cl_inv.c CL_DrawInventory: 17 rows round the selected item
    public func inventory [ cv: Canvas, w: Window, held: vec i32,
                            selected: i32, binds: vec string,
                            blink: bool ]
        index : vec i32 []
        selected_num : i32 [ 0 ]
        for [ i: i32 0, i < g.num_items && i < held.count, i += 1 ]
            if [ i == selected ] selected_num = index.count
            if [ held[ i ] != 0 ] index.push[ i ]
        num : i32 [ index.count ]
        # determine scroll point
        first : i32 [ selected_num - 8 ]
        if [ num - first < 17 ] first = num - 17
        if [ first < 0 ] first = 0
        px : f32 [ (wide - 256.0) / 2.0 ]
        py : f32 [ (high - 240.0) / 2.0 ]
        pic[ cv, w, 'inventory', px, py + 8.0 ]
        py = py + 24.0
        px = px + 24.0
        chars[ cv, w, 'hotkey ### item', px, py, false ]
        chars[ cv, w, '------ --- ----', px, py + 8.0, false ]
        py = py + 16.0
        for [ i: i32 first, i < num && i < first + 17, i += 1 ]
            item : i32 [ index[ i ] ]
            name : g.items[ item ].pickup_name
            # search for a binding: the number keys
            bind : '      '
            for [ k: i32 0, k < binds.count, k += 1 ]
                if [ binds[ k ] == name ] bind = '     {k}'
            count : padded[ held[ item ], 3 ]
            row : '{bind} {count} {name}'
            # a blinky cursor by the selected item; the rest green
            if [ item == selected && blink ]
                glyph[ cv, w, 15, px - 8.0, py ]
            chars[ cv, w, row, px, py, item != selected ]
            py = py + 8.0

    # SCR_DrawCenterString: lines of 40 at most, centred
    public func center [ cv: Canvas, w: Window, s: string ]
        lines : s.split[ '\n' ]
        py : f32 [ (lines.count <= 4) ? high * 0.35 : 48.0 ]
        for [ i: i32 0, i < lines.count, i += 1 ]
            l : lines[ i ]
            chars[ cv, w, l, (wide - 8.0 * f32[ l.count ]) / 2.0, py,
                   false ]
            py = py + 8.0

    # a string at the pen: the console's 8 pixel letters
    func text [ cv: Canvas, w: Window, s: string, px: f32, py: f32 ]
        chars[ cv, w, s, px, py, false ]

    # SCR_ExecuteLayoutString
    public func layout [ cv: Canvas, w: Window, program: string,
                         st: vec i32, flash: bool ]
        words : program.split[ ' ' ]
        n : i32 [ words.count ]
        x = 0.0
        y = 0.0
        i : i32 [ 0 ]
        while [ i < n ]
            t : words[ i ]
            i += 1
            arg : i32 [ (i < n) ? atoi[ words[ i ].chars ] : 0 ]
            if [ t == 'xl' ]
                x = arg
                i += 1
            el [ t == 'xr' ]
                x = wide + f32[ arg ]
                i += 1
            el [ t == 'xv' ]
                x = wide / 2.0 - 160.0 + f32[ arg ]
                i += 1
            el [ t == 'yt' ]
                y = arg
                i += 1
            el [ t == 'yb' ]
                y = high + f32[ arg ]
                i += 1
            el [ t == 'yv' ]
                y = high / 2.0 - 120.0 + f32[ arg ]
                i += 1
            el [ t == 'pic' ]
                # a pic from a stat number
                i += 1
                image : i32 [ st[ arg ] ]
                if [ image > 0 && image < g.images.count ]
                    pic[ cv, w, g.images[ image ], x, y ]
            el [ t == 'picn' ]
                pic[ cv, w, words[ i ], x, y ]
                i += 1
            el [ t == 'num' ]
                stat : i32 [ (i + 1 < n) ? atoi[ words[ i + 1 ].chars ]
                             : 0 ]
                i += 2
                field[ cv, w, 0, arg, st[ stat ] ]
            el [ t == 'hnum' ]
                # health: green above 25, flashing down to 1, then red
                value : i32 [ st[ STAT_HEALTH ] ]
                color : i32 [ 1 ]
                if [ value > 25 ]     color = 0
                el [ value > 0 ]      color = (flash) ? 1 : 0
                if [ st[ STAT_FLASHES ] & 1 ]
                    pic[ cv, w, 'field_3', x, y ]
                field[ cv, w, color, 3, value ]
            el [ t == 'anum' ]
                # ammo: a negative number is not shown
                value : i32 [ st[ STAT_AMMO ] ]
                if [ value < 0 ] continue
                color : i32 [ (value > 5 || !flash) ? 0 : 1 ]
                if [ st[ STAT_FLASHES ] & 4 ]
                    pic[ cv, w, 'field_3', x, y ]
                field[ cv, w, color, 3, value ]
            el [ t == 'rnum' ]
                value : i32 [ st[ STAT_ARMOR ] ]
                if [ value < 1 ] continue
                if [ st[ STAT_FLASHES ] & 2 ]
                    pic[ cv, w, 'field_3', x, y ]
                field[ cv, w, 0, 3, value ]
            el [ t == 'stat_string' ]
                # CS_ITEMS: the stat is an item's number
                i += 1
                item : i32 [ st[ arg ] ]
                if [ item > 0 && item < g.num_items ]
                    text[ cv, w, g.items[ item ].pickup_name, x, y ]
            el [ t == 'if' ]
                i += 1
                if [ st[ arg ] == 0 ]
                    # skip to endif
                    while [ i < n && words[ i ] != 'endif' ] i += 1

    # the status bar over the view; the screen in layout pixels
    public func draw [ cv: Canvas, w: Window, width: f32, height: f32,
                       st: vec i32, flash: bool ]
        scale = floor[ height / 240.0 ]
        if [ scale < 1.0 ] scale = 1.0
        wide = width / scale
        high = height / scale
        layout[ cv, w, hud_statusbar[], st, flash ]
