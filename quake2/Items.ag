# g_items.c: the item list, pickups, uses and drops
extend quake2

# one item of the table; the armors carry their protection
func item_add [ classname: string, pickup: lambda bool [ Edict, Edict ],
                use: lambda none [ Edict, GItem ],
                drop: lambda none [ Edict, GItem ],
                weaponthink: lambda none [ Edict ], pickup_sound: string,
                world_model: string, world_model_flags: i32,
                view_model: string, icon: string, pickup_name: string,
                count_width: i32, quantity: i32, ammo: string,
                flags: i32, weapmodel: i32, tag: i32,
                precaches: string ] -> GItem
    it : GItem [ index: g.items.count, classname: classname,
                 pickup: pickup, use: use, drop: drop,
                 weaponthink: weaponthink, pickup_sound: pickup_sound,
                 world_model: world_model,
                 world_model_flags: world_model_flags,
                 view_model: view_model, icon: icon,
                 pickup_name: pickup_name, count_width: count_width,
                 quantity: quantity, ammo: ammo, flags: flags,
                 weapmodel: weapmodel, tag: tag, precaches: precaches ]
    g.items.push[ it ]
    return it

func item_armor [ it: GItem, base: i32, max: i32, normal: f32,
                  energy: f32 ]
    it.base_count = base
    it.max_count = max
    it.normal_protection = normal
    it.energy_protection = energy

# InitItems: itemlist[], in its order; index 0 is empty
