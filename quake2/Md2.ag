# MD2 models and their skins, drawn as gl_mesh.c drew them
extend quake2

MD2_MAX_VERTS : i32 [ 98304 ]
RF_MINLIGHT   : i32 [ 1 ]
RF_FULLBRIGHT : i32 [ 8 ]

enum Md2Surface
    skin : 0

# a skin from the atlas times the vertex light, as GL modulated it
ModelViewProject Md2Lit
    attrib skin  : LayoutBinding [ type:typeid[ Md2Surface ],
                                   id:Md2Surface.skin, count:1,
                                   format: typeid[ rgba8 ] ]
    attrib a_pos : VertexInput [ type:typeid[ vec3f ] ]
    attrib a_uv  : VertexInput [ type:typeid[ vec2f ] ]
    attrib a_col : VertexInput [ type:typeid[ vec4f ] ]

    attrib v_uv  : VertexOutput [ type:typeid[ vec2f ] ]
    attrib v_col : VertexOutput [ type:typeid[ vec4f ] ]
    attrib fragColor : FragmentOutput [ type:typeid[ vec4f ] ]

    func init [ ]
        model = mat4f.identity[]
        view  = mat4f.identity[]
        proj  = mat4f.identity[]

    func vertex [] -> GLSL none {
        v_uv        = a_uv;
        // alpha 2 marks the view weapon: opaque, its depth squeezed
        float hack  = step(1.5, a_col.a);
        v_col       = vec4(a_col.rgb, a_col.a - hack);
        mat4 mvp    = ubo.proj * ubo.view * ubo.model;
        gl_Position = mvp * vec4(a_pos, 1.0);
        gl_Position.z *= 1.0 - 0.7 * hack;
    }

    func fragment [] -> GLSL none {
        // intensity 2 on the texel, the colour clamped to one
        vec4 t    = texture(skin, v_uv);
        vec3 c    = min(t.rgb * 2.0, vec3(1.0));
        float al  = t.a * v_col.a;
        if (al < 0.004) discard;
        fragColor = vec4(c * min(v_col.rgb, vec3(1.0)), al);
    }

# one model file: its header fields, the bytes, the skins' places
class Md2
    public name       : string
    public file       : PakData
    public skin_w     : i32
    public skin_h     : i32
    public framesize  : i32
    public num_skins  : i32
    public num_xyz    : i32
    public num_tris   : i32
    public num_frames : i32
    public ofs_st     : i32
    public ofs_tris   : i32
    public ofs_frames : i32
    # each skin's atlas rect: u, v, width, height, all 0..1
    public rects      : vec f32
    # an sp2 sprite: each frame's width, height, origin x and y
    public sprite     : bool
    public frames     : vec i32

# one of the frame's two meshes: nine floats a vertex
class Md2Mesh
    public gp    : Gpu
    public out   : @f32
    public ready : bool
    public used  : i32

    public func begin [ to: Gpu ]
        gp = to
        ready = false
        used = 0
        # position 3, uv 2, colour 4 floats, packed in that order
        if [ gp.vertex_size != 36 ]
            log 'md2: vertex size {gp.vertex_size}, wanted 36'
            return
        out = @gp.vertex_data[ 0 ]
        ready = true

    public func finish []
        if [ !ready ] return
        gp.index_count = used
        gp.upload_verts[]

# the models of a map, one skin atlas, and the frame's triangles
class Md2Set
    public pak     : Pak
    public palette : vec u8
    public list    : vec Md2
    # model index -> 1 + its place in list; 0 until asked for
    public slot    : vec i32
    public atlas   : Image
    public atlas_w : i32 [ 2048 ]
    public atlas_h : i32 [ 2048 ]
    public pen_x   : i32
    public pen_y   : i32
    public pen_row : i32
    # skins placed since the texture last took them
    public pending : vec BspTex
    # the 162 normals of anorms.h, and their light at one yaw
    public anorms  : vec f32
    public dots    : vec f32
    # one entity's vertices in the world, and each one's light
    public xyz     : vec f32
    public shade   : vec f32
    # what depth hides, and what is seen through (no depth write)
    public solid   : Md2Mesh
    public clear   : Md2Mesh
    # the eye's right and up, quake axes: sprites and particles
    public vright  : vec3f
    public vup     : vec3f
    public vpn     : vec3f
    public eye     : vec3f

    func init []
        list    = vec Md2 []
        slot    = vec i32 []
        pending = vec BspTex []
        dots    = vec f32 [ 162 ]
        xyz     = vec f32 [ 2048 * 3 ]
        shade   = vec f32 [ 2048 ]
        atlas = Image [ width: atlas_w, height: atlas_h,
                        format: Pixel.rgba8, linear: true ]
        solid = Md2Mesh [ ]
        clear = Md2Mesh [ ]
        ad : @u8 [ atlas.vdata[] ]
        memset[ ad, 255, atlas_w * atlas_h * 4 ]
        # texels 0..3 stay white (beams, shells); the particle dot
        # of gl_rmisc.c sits at 6..15, clear all round it
        for [ y: i32 0, y < 10, y += 1 ]
            for [ x: i32 0, x < 10, x += 1 ]
                inside : bool [ y >= 1 && y <= 4 && x >= 1 && x <= 4 ]
                ends : bool [ y == 1 || y == 4 ]
                corner : bool [ ends && (x == 1 || x == 4) ]
                dot : bool [ inside && !corner ]
                ad[ (y * atlas_w + 6 + x) * 4 + 3 ] = (dot) ? 255 : 0
        pen_x = 18
        pen_row = 12
        anorms = vec f32 [] [
        -0.525731, 0.0, 0.850651, -0.442863, 0.238856, 0.864188,
        -0.295242, 0.0, 0.955423, -0.309017, 0.5, 0.809017, -0.16246,
        0.262866, 0.951056, 0.0, 0.0, 1.0, 0.0, 0.850651, 0.525731,
        -0.147621, 0.716567, 0.681718, 0.147621, 0.716567, 0.681718,
        0.0, 0.525731, 0.850651, 0.309017, 0.5, 0.809017, 0.525731, 0.0,
        0.850651, 0.295242, 0.0, 0.955423, 0.442863, 0.238856, 0.864188,
        0.16246, 0.262866, 0.951056, -0.681718, 0.147621, 0.716567,
        -0.809017, 0.309017, 0.5, -0.587785, 0.425325, 0.688191,
        -0.850651, 0.525731, 0.0, -0.864188, 0.442863, 0.238856,
        -0.716567, 0.681718, 0.147621, -0.688191, 0.587785, 0.425325,
        -0.5, 0.809017, 0.309017, -0.238856, 0.864188, 0.442863,
        -0.425325, 0.688191, 0.587785, -0.716567, 0.681718, -0.147621,
        -0.5, 0.809017, -0.309017, -0.525731, 0.850651, 0.0, 0.0,
        0.850651, -0.525731, -0.238856, 0.864188, -0.442863, 0.0,
        0.955423, -0.295242, -0.262866, 0.951056, -0.16246, 0.0, 1.0,
        0.0, 0.0, 0.955423, 0.295242, -0.262866, 0.951056, 0.16246,
        0.238856, 0.864188, 0.442863, 0.262866, 0.951056, 0.16246, 0.5,
        0.809017, 0.309017, 0.238856, 0.864188, -0.442863, 0.262866,
        0.951056, -0.16246, 0.5, 0.809017, -0.309017, 0.850651,
        0.525731, 0.0, 0.716567, 0.681718, 0.147621, 0.716567, 0.681718,
