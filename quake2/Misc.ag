# target_character and target_string: a readout of digits
func sp_target_character [ e: Edict ]
    e.movetype = MOVETYPE_PUSH
    g.setmodel[ e, e.model ]
    e.solid = SOLID_BSP
    e.frame = 12
    g.world.link[ e ]

func target_string_use [ e: Edict, other: Edict, activator: Edict ]
    l : i32 [ e.message.count ]
    t : e.teammaster
    while [ t ]
        if [ t.count != 0 ]
            n : i32 [ t.count - 1 ]
            if [ n > l ]
                t.frame = 12
            el
                c : i32 [ e.message[ n ] ]
                if [ c >= 48 && c <= 57 ]      t.frame = c - 48
                el [ c == 45 ]                 t.frame = 10
                el [ c == 58 ]                 t.frame = 11
                el                             t.frame = 12
        t = t.teamchain

func sp_target_string [ e: Edict ]
    if [ !e.message ] e.message = ''
    e.use = lambda target_string_use[]

# func_clock: a time of day clock, or a timer up or down
func func_clock_reset [ e: Edict ]
    e.activator = null
    if [ e.spawnflags & 1 ]
        e.health = 0
        e.wait = f32[ e.count ]
    el [ e.spawnflags & 2 ]
        e.health = e.count
        e.wait = 0.0

func two_digits [ n: i32 ] -> string
    if [ n < 10 ] return '0{n}'
    return '{n}'

func func_clock_format_countdown [ e: Edict ]
    if [ e.style == 0 ]
        e.message = '{e.health}'
    el [ e.style == 1 ]
        e.message = '{e.health / 60}:{two_digits[ e.health % 60 ]}'
    el [ e.style == 2 ]
        h : i32 [ e.health / 3600 ]
        m : i32 [ (e.health - h * 3600) / 60 ]
        e.message = '{h}:{two_digits[ m ]}:{two_digits[ e.health % 60 ]}'

func func_clock_think [ e: Edict ]
    if [ !e.enemy ]
        e.enemy = g.find[ null, EField.targetname, e.target ]
        if [ !e.enemy ] return
    if [ e.spawnflags & 1 ]
        func_clock_format_countdown[ e ]
        e.health += 1
    el [ e.spawnflags & 2 ]
        func_clock_format_countdown[ e ]
        e.health -= 1
    el
        now : i64 [ time[ null ] ]
        secs : i32 [ now % 86400 ]
        e.message = '{secs / 3600}:{two_digits[ (secs / 60) % 60 ]}:{two_digits[ secs % 60 ]}'
    e.enemy.message = e.message
    if [ e.enemy.use ] e.enemy.use[ e.enemy, e, e ]
    if [ ((e.spawnflags & 1) != 0 && f32[ e.health ] > e.wait) ||
         ((e.spawnflags & 2) != 0 && f32[ e.health ] < e.wait) ]
        if [ e.pathtarget ]
            savetarget : string [ e.target ]
            savemessage : string [ e.message ]
            e.target = e.pathtarget
            e.message = null
            g.use_targets[ e, e.activator ]
            e.target = savetarget
            e.message = savemessage
        if [ (e.spawnflags & 8) == 0 ] return
        func_clock_reset[ e ]
        if [ e.spawnflags & 4 ] return
    e.nextthink = g.level.time + 1.0

func func_clock_use [ e: Edict, other: Edict, activator: Edict ]
    if [ (e.spawnflags & 8) == 0 ] e.use = null
    if [ e.activator ] return
    e.activator = activator
    e.think[ e ]

func sp_func_clock [ e: Edict ]
    if [ !e.target ]
        g.dprintf[ '{e.classname} with no target' ]
        g.free_edict[ e ]
        return
    if [ (e.spawnflags & 2) != 0 && e.count == 0 ]
        g.dprintf[ '{e.classname} with no count' ]
        g.free_edict[ e ]
        return
    if [ (e.spawnflags & 1) != 0 && e.count == 0 ] e.count = 60 * 60
    func_clock_reset[ e ]
    e.message = ''
    e.think = lambda func_clock_think[]
    if [ e.spawnflags & 4 ] e.use = lambda func_clock_use[]
    el                      e.nextthink = g.level.time + 1.0

# ---- the teleporter
func teleporter_touch [ e: Edict, other: Edict ]
    if [ !other.client ] return
    dest : g.find[ null, EField.targetname, e.target ]
    if [ !dest ]
        g.dprintf[ 'Could not find destination' ]
        return
    # unlink to make sure it can't possibly interfere with KillBox
    g.world.unlink[ other ]
    other.origin = vec3f [ dest.origin.x, dest.origin.y, dest.origin.z + 10.0 ]
    other.old_origin = other.origin
    # clear the velocity and hold them in place briefly
    other.velocity = vec3f [ 0.0, 0.0, 0.0 ]
    other.client.ps.pm_time = 160 >> 3
    other.client.ps.pm_flags = other.client.ps.pm_flags | PMF_TIME_TELEPORT
    # draw the teleport splash at source and on the player
    e.owner.event = EV_PLAYER_TELEPORT
    other.event = EV_PLAYER_TELEPORT
    # set angles
    other.client.ps.delta_angles = v_sub[ dest.angles,
                                          other.client.resp.cmd_angles ]
    other.angles = vec3f [ 0.0, 0.0, 0.0 ]
    other.client.ps.viewangles = dest.angles
    other.client.v_angle = dest.angles
    # kill anything at the destination
    g.kill_box[ other ]
    g.world.link[ other ]

func sp_misc_teleporter [ e: Edict ]
    if [ !e.target ]
        g.dprintf[ 'teleporter without a target.' ]
        g.free_edict[ e ]
        return
    g.setmodel[ e, 'models/objects/dmspot/tris.md2' ]
    e.skinnum = 1
    e.effects = EF_TELEPORTER
    e.sound = g.soundindex[ 'world/amb10.wav' ]
    e.solid = SOLID_BBOX
    e.mins = vec3f [ -32.0, -32.0, -24.0 ]
    e.maxs = vec3f [ 32.0, 32.0, -16.0 ]
    g.world.link[ e ]
    trig : g.spawn[]
    trig.touch = lambda teleporter_touch[]
    trig.solid = SOLID_TRIGGER
    trig.target = e.target
    trig.owner = e
    trig.origin = e.origin
    trig.mins = vec3f [ -8.0, -8.0, 8.0 ]
    trig.maxs = vec3f [ 8.0, 8.0, 24.0 ]
    g.world.link[ trig ]

func sp_misc_teleporter_dest [ e: Edict ]
    g.setmodel[ e, 'models/objects/dmspot/tris.md2' ]
    e.skinnum = 0
    e.solid = SOLID_BBOX
    e.mins = vec3f [ -32.0, -32.0, -24.0 ]
    e.maxs = vec3f [ 32.0, 32.0, -16.0 ]
    g.world.link[ e ]

# ---- the spawn table for g_misc, the player spots and the monsters
func spawn_class [ c: string, e: Edict ] -> bool
    if [ c == 'point_combat' ]            sp_point_combat[ e ]
    el [ c == 'viewthing' ]               sp_viewthing[ e ]
    el [ c == 'info_notnull' ]            sp_info_notnull[ e ]
    el [ c == 'light' ]                   sp_light_point[ e ]
    el [ c == 'misc_explobox' ]           sp_misc_explobox[ e ]
    el [ c == 'misc_blackhole' ]          sp_misc_blackhole[ e ]
    el [ c == 'misc_eastertank' ]         sp_misc_eastertank[ e ]
    el [ c == 'misc_easterchick' ]        sp_misc_easterchick[ e ]
    el [ c == 'misc_easterchick2' ]       sp_misc_easterchick2[ e ]
    el [ c == 'monster_commander_body' ]  sp_monster_commander_body[ e ]
    el [ c == 'misc_banner' ]             sp_misc_banner[ e ]
    el [ c == 'misc_deadsoldier' ]        sp_misc_deadsoldier[ e ]
    el [ c == 'misc_viper' ]              sp_misc_viper[ e ]
    el [ c == 'misc_bigviper' ]           sp_misc_bigviper[ e ]
    el [ c == 'misc_viper_bomb' ]         sp_misc_viper_bomb[ e ]
    el [ c == 'misc_strogg_ship' ]        sp_misc_strogg_ship[ e ]
    el [ c == 'misc_satellite_dish' ]     sp_misc_satellite_dish[ e ]
    el [ c == 'light_mine1' ]
        sp_light_mine[ e, 'models/objects/minelite/light1/tris.md2' ]
    el [ c == 'light_mine2' ]
        sp_light_mine[ e, 'models/objects/minelite/light2/tris.md2' ]
    el [ c == 'misc_gib_arm' ]
        sp_misc_gib[ e, 'models/objects/gibs/arm/tris.md2' ]
    el [ c == 'misc_gib_leg' ]
        sp_misc_gib[ e, 'models/objects/gibs/leg/tris.md2' ]
    el [ c == 'misc_gib_head' ]
        sp_misc_gib[ e, 'models/objects/gibs/head/tris.md2' ]
    el [ c == 'target_character' ]        sp_target_character[ e ]
    el [ c == 'target_string' ]           sp_target_string[ e ]
    el [ c == 'func_clock' ]              sp_func_clock[ e ]
    el [ c == 'misc_teleporter' ]         sp_misc_teleporter[ e ]
    el [ c == 'misc_teleporter_dest' ]    sp_misc_teleporter_dest[ e ]
    el [ c == 'info_player_start' ]       sp_info_player_start[ e ]
    el [ c == 'info_player_deathmatch' ]  sp_info_player_deathmatch[ e ]
    el [ c == 'info_player_coop' ]        sp_info_player_coop[ e ]
    el [ c == 'info_player_intermission' ] return true
    el                                    return spawn_monster[ c, e ]
    return true

# the monsters, file by file
func spawn_monster [ c: string, e: Edict ] -> bool
    if [ c == 'monster_soldier_light' ]  sp_monster_soldier_light[ e ]
    el [ c == 'monster_soldier' ]        sp_monster_soldier[ e ]
    el [ c == 'monster_soldier_ss' ]     sp_monster_soldier_ss[ e ]
    el [ c == 'monster_infantry' ]       sp_monster_infantry[ e ]
    el [ c == 'monster_gunner' ]         sp_monster_gunner[ e ]
    el [ c == 'monster_berserk' ]        sp_monster_berserk[ e ]
    el [ c == 'monster_gladiator' ]      sp_monster_gladiator[ e ]
    el [ c == 'monster_flipper' ]        sp_monster_flipper[ e ]
    el [ c == 'monster_flyer' ]          sp_monster_flyer[ e ]
    el [ c == 'monster_hover' ]          sp_monster_hover[ e ]
    el [ c == 'monster_medic' ]          sp_monster_medic[ e ]
    el [ c == 'monster_mutant' ]         sp_monster_mutant[ e ]
    el [ c == 'monster_parasite' ]       sp_monster_parasite[ e ]
    el [ c == 'monster_tank' ]           sp_monster_tank[ e ]
    el [ c == 'monster_tank_commander' ] sp_monster_tank[ e ]
    el [ c == 'monster_chick' ]          sp_monster_chick[ e ]
    el [ c == 'monster_brain' ]          sp_monster_brain[ e ]
    el [ c == 'misc_insane' ]            sp_misc_insane[ e ]
    el [ c == 'monster_floater' ]        sp_monster_floater[ e ]
    el [ c == 'monster_supertank' ]      sp_monster_supertank[ e ]
    el [ c == 'misc_actor' ]             sp_misc_actor[ e ]
    el [ c == 'target_actor' ]           sp_target_actor[ e ]
    el [ c == 'monster_boss2' ]          sp_monster_boss2[ e ]
    el [ c == 'monster_jorg' ]           sp_monster_jorg[ e ]
    el [ c == 'monster_makron' ]         sp_monster_makron[ e ]
    el [ c == 'monster_boss3_stand' ]    sp_monster_boss3_stand[ e ]
    el [ c == 'turret_breach' ]          sp_turret_breach[ e ]
    el [ c == 'turret_base' ]            sp_turret_base[ e ]
    el [ c == 'turret_driver' ]          sp_turret_driver[ e ]
    el                                   return false
    return true
