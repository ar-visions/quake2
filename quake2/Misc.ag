# misc_viper_bomb
func misc_viper_bomb_touch [ e: Edict, other: Edict ]
    g.use_targets[ e, e.activator ]
    e.origin = vec3f [ e.origin.x, e.origin.y, e.absmin.z + 1.0 ]
    t_radius_damage[ e, e, f32[ e.dmg ], null, f32[ e.dmg + 40 ], MOD_BOMB ]
    become_explosion2[ e ]

func misc_viper_bomb_prethink [ e: Edict ]
    e.groundentity = null
    diff : f32 [ e.timestamp - g.level.time ]
    if [ diff < -1.0 ] diff = -1.0
    v : v_scale[ e.moveinfo.dir, 1.0 + diff ]
    v = vec3f [ v.x, v.y, diff ]
    roll : f32 [ e.angles.z ]
    e.angles = vectoangles[ v ]
    e.angles = vec3f [ e.angles.x, e.angles.y, roll + 10.0 ]

func misc_viper_bomb_use [ e: Edict, other: Edict, activator: Edict ]
    e.solid = SOLID_BBOX
    e.svflags = e.svflags & ~SVF_NOCLIENT
    e.effects = e.effects | EF_ROCKET
    e.use = null
    e.movetype = MOVETYPE_TOSS
    e.prethink = lambda misc_viper_bomb_prethink[]
    e.touch = lambda misc_viper_bomb_touch[]
    e.activator = activator
    viper : g.find[ null, EField.classname, 'misc_viper' ]
    if [ !viper ] return
    e.velocity = v_scale[ viper.moveinfo.dir, viper.moveinfo.speed ]
    e.timestamp = g.level.time
    e.moveinfo.dir = viper.moveinfo.dir

func sp_misc_viper_bomb [ e: Edict ]
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_NOT
    e.mins = vec3f [ -8.0, -8.0, -8.0 ]
    e.maxs = vec3f [ 8.0, 8.0, 8.0 ]
    e.modelindex = g.modelindex[ 'models/objects/bomb/tris.md2' ]
    if [ e.dmg == 0 ] e.dmg = 1000
    e.use = lambda misc_viper_bomb_use[]
    e.svflags = e.svflags | SVF_NOCLIENT
    g.world.link[ e ]

