# misc_deadsoldier: the dead player model in six poses
func misc_deadsoldier_die [ e: Edict, inflictor: Edict, attacker: Edict,
                            damage: i32, point: vec3f ]
    if [ e.health > -80 ] return
    g.sound[ e, CHAN_BODY, g.soundindex[ 'misc/udeath.wav' ], 1.0, ATTN_NORM ]
    for [ n: i32 0, n < 4, n += 1 ]
        throw_gib[ e, 'models/objects/gibs/sm_meat/tris.md2', damage,
                   GIB_ORGANIC ]
    throw_head[ e, 'models/objects/gibs/head2/tris.md2', damage, GIB_ORGANIC ]

func sp_misc_deadsoldier [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_BBOX
    e.modelindex = g.modelindex[ 'models/deadbods/dude/tris.md2' ]
    # defaults to frame 0
    if [ e.spawnflags & 2 ]        e.frame = 1
    el [ e.spawnflags & 4 ]        e.frame = 2
    el [ e.spawnflags & 8 ]        e.frame = 3
    el [ e.spawnflags & 16 ]       e.frame = 4
    el [ e.spawnflags & 32 ]       e.frame = 5
    el                             e.frame = 0
    e.mins = vec3f [ -16.0, -16.0, 0.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 16.0 ]
    e.deadflag = DEAD_DEAD
    e.takedamage = DAMAGE_YES
    e.svflags = e.svflags | SVF_MONSTER | SVF_DEADMONSTER
    e.die = lambda misc_deadsoldier_die[]
    e.monsterinfo.aiflags = e.monsterinfo.aiflags | AI_GOOD_GUY
    g.world.link[ e ]

# misc_viper and misc_strogg_ship: flybys that ride a path like a train
func misc_flyby_use [ e: Edict, other: Edict, activator: Edict ]
    e.svflags = e.svflags & ~SVF_NOCLIENT
    e.use = lambda train_use[]
    train_use[ e, other, activator ]

func sp_misc_flyby [ e: Edict, model: string ]
    if [ !e.target ]
        g.dprintf[ '{e.classname} without a target' ]
        g.free_edict[ e ]
        return
    if [ e.speed == 0.0 ] e.speed = 300.0
    e.movetype = MOVETYPE_PUSH
    e.solid = SOLID_NOT
    e.modelindex = g.modelindex[ model ]
    e.mins = vec3f [ -16.0, -16.0, 0.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 32.0 ]
    e.think = lambda func_train_find[]
    e.nextthink = g.level.time + FRAMETIME
    e.use = lambda misc_flyby_use[]
    e.svflags = e.svflags | SVF_NOCLIENT
    e.moveinfo.accel = e.speed
    e.moveinfo.decel = e.speed
    e.moveinfo.speed = e.speed
    g.world.link[ e ]

func sp_misc_viper [ e: Edict ]
