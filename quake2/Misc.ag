# monster_commander_body: the tank commander's decapitated body
func commander_body_think [ e: Edict ]
    e.frame += 1
    if [ e.frame < 24 ] e.nextthink = g.level.time + FRAMETIME
    el                  e.nextthink = 0.0
    if [ e.frame == 22 ]
        g.sound[ e, CHAN_BODY, g.soundindex[ 'tank/thud.wav' ], 1.0, ATTN_NORM ]

func commander_body_use [ e: Edict, other: Edict, activator: Edict ]
