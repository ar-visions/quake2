# g_misc.c: the brush classes; the rest of the file comes with items
extend quake2

MASK_MONSTERSOLID : i32 [ 1 | 131072 | 2 | 33554432 ]

# g_misc.c path_corner: a train's or monster's waypoint
func sp_path_corner [ e: Edict ]
    if [ !e.targetname ]
        g.dprintf[ 'path_corner with no targetname' ]
        g.free_edict[ e ]
        return
    e.solid = SOLID_TRIGGER
    e.touch = lambda path_corner_touch[]
    e.mins = vec3f [ -8.0, -8.0, -8.0 ]
    e.maxs = vec3f [ 8.0, 8.0, 8.0 ]
    e.svflags = e.svflags | SVF_NOCLIENT
    g.world.link[ e ]

func path_corner_touch [ e: Edict, other: Edict ]
    if [ other.movetarget != e ] return
    if [ other.enemy ] return
    if [ e.pathtarget ]
        savetarget : string [ e.target ]
        e.target = e.pathtarget
        g.use_targets[ e, other ]
        e.target = savetarget
    next : Edict [ (e.target) ? g.pick_target[ e.target ] : null ]
    if [ next && (next.spawnflags & 1) != 0 ]
        other.origin = vec3f [ next.origin.x, next.origin.y,
            next.origin.z + next.mins.z - other.mins.z ]
        next = g.pick_target[ next.target ]
        other.event = EV_OTHER_TELEPORT
    other.goalentity = next
    other.movetarget = next
    if [ e.wait != 0.0 ]
        other.monsterinfo.pausetime = g.level.time + e.wait
        other.monsterinfo.stand[ other ]
        return
    if [ !other.movetarget ]
        other.monsterinfo.pausetime = g.level.time + 100000000.0
        other.monsterinfo.stand[ other ]
    el
        other.ideal_yaw = vectoyaw[ v_sub[ other.goalentity.origin,
                                           other.origin ] ]


# ---- func_wall
func func_wall_use [ e: Edict, other: Edict, activator: Edict ]
    if [ e.solid == SOLID_NOT ]
        e.solid = SOLID_BSP
        e.svflags = e.svflags & ~SVF_NOCLIENT
        g.kill_box[ e ]
    el
        e.solid = SOLID_NOT
        e.svflags = e.svflags | SVF_NOCLIENT
    g.world.link[ e ]
    if [ (e.spawnflags & 2) == 0 ] e.use = null

func sp_func_wall [ e: Edict ]
    e.movetype = MOVETYPE_PUSH
    g.setmodel[ e, e.model ]
    if [ e.spawnflags & 8 ]  e.effects = e.effects | EF_ANIM_ALL
    if [ e.spawnflags & 16 ] e.effects = e.effects | EF_ANIM_ALLFAST
    # just a wall
    if [ (e.spawnflags & 7) == 0 ]
        e.solid = SOLID_BSP
        g.world.link[ e ]
        return
    # it must be TRIGGER_SPAWN
    if [ (e.spawnflags & 1) == 0 ] e.spawnflags = e.spawnflags | 1
    if [ (e.spawnflags & 4) != 0 && (e.spawnflags & 2) == 0 ]
        g.dprintf[ 'func_wall START_ON without TOGGLE' ]
        e.spawnflags = e.spawnflags | 2
    e.use = lambda func_wall_use[]
    if [ e.spawnflags & 4 ]
        e.solid = SOLID_BSP
    el
        e.solid = SOLID_NOT
        e.svflags = e.svflags | SVF_NOCLIENT
    g.world.link[ e ]

# ---- func_object: a brush that falls once its support goes
func func_object_touch [ e: Edict, other: Edict ]
    # only squash thing we fall on top of
    if [ !g.touch_plane_on ] return
    if [ g.touch_plane.nz < 1.0 ] return
    if [ other.takedamage == DAMAGE_NO ] return
    zero : vec3f [ 0.0, 0.0, 0.0 ]
    t_damage[ other, e, e, zero, e.origin, zero, e.dmg, 1, 0, MOD_CRUSH ]

func func_object_release [ e: Edict ]
    e.movetype = MOVETYPE_TOSS
    e.touch = lambda func_object_touch[]

func func_object_use [ e: Edict, other: Edict,
                       activator: Edict ]
    e.solid = SOLID_BSP
    e.svflags = e.svflags & ~SVF_NOCLIENT
    e.use = null
    g.kill_box[ e ]
    func_object_release[ e ]

func sp_func_object [ e: Edict ]
    g.setmodel[ e, e.model ]
    e.mins = vec3f [ e.mins.x + 1.0, e.mins.y + 1.0, e.mins.z + 1.0 ]
    e.maxs = vec3f [ e.maxs.x - 1.0, e.maxs.y - 1.0, e.maxs.z - 1.0 ]
    if [ e.dmg == 0 ] e.dmg = 100
    if [ e.spawnflags == 0 ]
        e.solid = SOLID_BSP
        e.movetype = MOVETYPE_PUSH
        e.think = lambda func_object_release[]
        e.nextthink = g.level.time + 2.0 * FRAMETIME
    el
        e.solid = SOLID_NOT
        e.movetype = MOVETYPE_PUSH
        e.use = lambda func_object_use[]
        e.svflags = e.svflags | SVF_NOCLIENT
    if [ e.spawnflags & 2 ] e.effects = e.effects | EF_ANIM_ALL
    if [ e.spawnflags & 4 ] e.effects = e.effects | EF_ANIM_ALLFAST
    e.clipmask = MASK_MONSTERSOLID
    g.world.link[ e ]

# ---- func_explosive
func func_explosive_explode [ e: Edict, inflictor: Edict,
                              attacker: Edict ]
    # bmodel origins are 0 0 0: the centre of its box
    size : v_scale[ e.size, 0.5 ]
    e.origin = v_add[ e.absmin, size ]
    e.takedamage = DAMAGE_NO
    if [ e.dmg != 0 ]
        t_radius_damage[ e, attacker, f32[ e.dmg ], null, f32[ e.dmg + 40 ],
                         MOD_EXPLOSIVE ]
    e.velocity = v_scale[ v_norm[ v_sub[ e.origin, inflictor.origin ] ],
                          150.0 ]
    # start chunks towards the center
    half : v_scale[ size, 0.5 ]
    mass : i32 [ (e.mass != 0) ? e.mass : 75 ]
    # big chunks
    if [ mass >= 100 ]
        count : i32 [ mass / 100 ]
        if [ count > 8 ] count = 8
        for [ i: i32 0, i < count, i += 1 ]
            chunkorigin : vec3f [ e.origin.x + crandom[] * half.x,
                                  e.origin.y + crandom[] * half.y,
                                  e.origin.z + crandom[] * half.z ]
            throw_debris[ e, 'models/objects/debris1/tris.md2', 1.0,
                          chunkorigin ]
    # small chunks
    count : i32 [ mass / 25 ]
    if [ count > 16 ] count = 16
    for [ i: i32 0, i < count, i += 1 ]
        chunkorigin : vec3f [ e.origin.x + crandom[] * half.x,
                              e.origin.y + crandom[] * half.y,
                              e.origin.z + crandom[] * half.z ]
        throw_debris[ e, 'models/objects/debris2/tris.md2', 2.0, chunkorigin ]
    g.use_targets[ e, attacker ]
    if [ e.dmg != 0 ] become_explosion1[ e ]
    el                g.free_edict[ e ]

func func_explosive_use [ e: Edict, other: Edict,
                          activator: Edict ]
    func_explosive_explode[ e, e, other ]

func func_explosive_spawn [ e: Edict, other: Edict,
                            activator: Edict ]
    e.solid = SOLID_BSP
    e.svflags = e.svflags & ~SVF_NOCLIENT
    e.use = null
    g.kill_box[ e ]
    g.world.link[ e ]

func sp_func_explosive [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    e.movetype = MOVETYPE_PUSH
    g.modelindex[ 'models/objects/debris1/tris.md2' ]
    g.modelindex[ 'models/objects/debris2/tris.md2' ]
    g.setmodel[ e, e.model ]
    targeted : bool [ false ]
    if [ e.spawnflags & 1 ]
        e.svflags = e.svflags | SVF_NOCLIENT
        e.solid = SOLID_NOT
        e.use = lambda func_explosive_spawn[]
    el
        e.solid = SOLID_BSP
        if [ e.targetname ]
            e.use = lambda func_explosive_use[]
            targeted = true
    if [ e.spawnflags & 2 ] e.effects = e.effects | EF_ANIM_ALL
    if [ e.spawnflags & 4 ] e.effects = e.effects | EF_ANIM_ALLFAST
    if [ !targeted ]
        if [ e.health == 0 ] e.health = 100
        e.die = lambda func_explosive_explode[]
        e.takedamage = DAMAGE_YES
    g.world.link[ e ]

# ---- gibs
func velocity_for_damage [ damage: i32 ] -> vec3f
    v : vec3f [ 100.0 * crandom[], 100.0 * crandom[], 200.0 + 100.0 * frand[] ]
    if [ damage < 50 ] return v_scale[ v, 0.7 ]
    return v_scale[ v, 1.2 ]

func clip_gib_velocity [ e: Edict ]
    e.velocity = vec3f [ clamp[ e.velocity.x, -300.0, 300.0 ],
                         clamp[ e.velocity.y, -300.0, 300.0 ],
                         clamp[ e.velocity.z, 200.0, 500.0 ] ]

func gib_think [ e: Edict ]
    e.frame += 1
    e.nextthink = g.level.time + FRAMETIME
    if [ e.frame == 10 ]
        e.think = lambda remove_edict[]
        e.nextthink = g.level.time + 8.0 + frand[] * 10.0

func gib_touch [ e: Edict, other: Edict ]
    if [ !e.groundentity ] return
    e.touch = null
    if [ g.touch_plane_on ]
        g.sound[ e, CHAN_VOICE, g.soundindex[ 'misc/fhit3.wav' ], 1.0,
                 ATTN_NORM ]
        normal_angles : vectoangles[ touch_normal[] ]
        ax : angle_vectors[ normal_angles ]
        e.angles = vectoangles[ ax.right ]
        if [ e.modelindex == g.sm_meat_index ]
            e.frame += 1
            e.think = lambda gib_think[]
            e.nextthink = g.level.time + FRAMETIME

func gib_die [ e: Edict, inflictor: Edict, attacker: Edict, damage: i32,
               point: vec3f ]
    g.free_edict[ e ]

func throw_gib [ e: Edict, gibname: string, damage: i32, kind: i32 ]
    gib : g.spawn[]
    size : v_scale[ e.size, 0.5 ]
    origin : v_add[ e.absmin, size ]
    gib.origin = vec3f [ origin.x + crandom[] * size.x,
                         origin.y + crandom[] * size.y,
                         origin.z + crandom[] * size.z ]
    g.setmodel[ gib, gibname ]
    gib.solid = SOLID_NOT
    gib.effects = gib.effects | EF_GIB
    gib.flags = gib.flags | FL_NO_KNOCKBACK
    gib.takedamage = DAMAGE_YES
    gib.die = lambda gib_die[]
    vscale : f32 [ 1.0 ]
    if [ kind == GIB_ORGANIC ]
        gib.movetype = MOVETYPE_TOSS
        gib.touch = lambda gib_touch[]
        vscale = 0.5
    el
        gib.movetype = MOVETYPE_BOUNCE
    gib.velocity = v_ma[ e.velocity, vscale, velocity_for_damage[ damage ] ]
    clip_gib_velocity[ gib ]
    gib.avelocity = vec3f [ frand[] * 600.0, frand[] * 600.0, frand[] * 600.0 ]
    gib.think = lambda remove_edict[]
    gib.nextthink = g.level.time + 10.0 + frand[] * 10.0
    g.world.link[ gib ]

func throw_head [ e: Edict, gibname: string, damage: i32, kind: i32 ]
    e.skinnum = 0
    e.frame = 0
    e.mins = vec3f [ 0.0, 0.0, 0.0 ]
    e.maxs = vec3f [ 0.0, 0.0, 0.0 ]
    e.modelindex2 = 0
    g.setmodel[ e, gibname ]
    e.solid = SOLID_NOT
    e.effects = e.effects | EF_GIB
    e.effects = e.effects & ~EF_FLIES
    e.sound = 0
    e.flags = e.flags | FL_NO_KNOCKBACK
    e.svflags = e.svflags & ~SVF_MONSTER
    e.takedamage = DAMAGE_YES
    e.die = lambda gib_die[]
    vscale : f32 [ 1.0 ]
    if [ kind == GIB_ORGANIC ]
        e.movetype = MOVETYPE_TOSS
        e.touch = lambda gib_touch[]
        vscale = 0.5
    el
        e.movetype = MOVETYPE_BOUNCE
    e.velocity = v_ma[ e.velocity, vscale, velocity_for_damage[ damage ] ]
    clip_gib_velocity[ e ]
    e.avelocity = vec3f [ e.avelocity.x, crandom[] * 600.0, e.avelocity.z ]
    e.think = lambda remove_edict[]
    e.nextthink = g.level.time + 10.0 + frand[] * 10.0
    g.world.link[ e ]

func throw_client_head [ e: Edict, damage: i32 ]
    gibname : string [ 'models/objects/gibs/skull/tris.md2' ]
    if [ rand[] & 1 ]
        gibname = 'models/objects/gibs/head2/tris.md2'
        # second skin is player
        e.skinnum = 1
    el
        e.skinnum = 0
    e.origin = vec3f [ e.origin.x, e.origin.y, e.origin.z + 32.0 ]
    e.frame = 0
    g.setmodel[ e, gibname ]
    e.mins = vec3f [ -16.0, -16.0, 0.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 16.0 ]
    e.takedamage = DAMAGE_NO
    e.solid = SOLID_NOT
    e.effects = EF_GIB
    e.sound = 0
    e.flags = e.flags | FL_NO_KNOCKBACK
    e.movetype = MOVETYPE_BOUNCE
    e.velocity = v_add[ e.velocity, velocity_for_damage[ damage ] ]
    if [ e.client ]
        # bodies in the queue don't have a client anymore
        e.client.anim_priority = ANIM_DEATH
        e.client.anim_end = e.frame
    el
        e.think = null
        e.nextthink = 0.0
    g.world.link[ e ]

# ---- debris
func debris_die [ e: Edict, inflictor: Edict, attacker: Edict, damage: i32,
                  point: vec3f ]
    g.free_edict[ e ]

func throw_debris [ e: Edict, modelname: string, speed: f32, origin: vec3f ]
    chunk : g.spawn[]
    chunk.origin = origin
    g.setmodel[ chunk, modelname ]
    v : vec3f [ 100.0 * crandom[], 100.0 * crandom[], 100.0 + 100.0 * crandom[] ]
    chunk.velocity = v_ma[ e.velocity, speed, v ]
    chunk.movetype = MOVETYPE_BOUNCE
    chunk.solid = SOLID_NOT
    chunk.avelocity = vec3f [ frand[] * 600.0, frand[] * 600.0,
                              frand[] * 600.0 ]
    chunk.think = lambda remove_edict[]
    chunk.nextthink = g.level.time + 5.0 + frand[] * 5.0
    chunk.frame = 0
    chunk.flags = 0
    chunk.classname = 'debris'
    chunk.takedamage = DAMAGE_YES
    chunk.die = lambda debris_die[]
    g.world.link[ chunk ]

func become_explosion1 [ e: Edict ]
    g.temp_entity_at[ TE_EXPLOSION1, e.origin ]
    g.free_edict[ e ]

func become_explosion2 [ e: Edict ]
    g.temp_entity_at[ TE_EXPLOSION2, e.origin ]
    g.free_edict[ e ]

# ---- point_combat
func point_combat_touch [ e: Edict, other: Edict ]
    if [ other.movetarget != e ] return
    if [ e.target ]
        other.target = e.target
        other.goalentity = g.pick_target[ other.target ]
        other.movetarget = other.goalentity
        if [ !other.goalentity ]
            g.dprintf[ '{e.classname} target {e.target} does not exist' ]
            other.movetarget = e
        e.target = null
    el [ (e.spawnflags & 1) != 0 && (other.flags & (FL_SWIM | FL_FLY)) == 0 ]
        other.monsterinfo.pausetime = g.level.time + 100000000.0
        other.monsterinfo.aiflags = other.monsterinfo.aiflags | AI_STAND_GROUND
        other.monsterinfo.stand[ other ]
    if [ other.movetarget == e ]
        other.target = null
        other.movetarget = null
        other.goalentity = other.enemy
        other.monsterinfo.aiflags = other.monsterinfo.aiflags & ~AI_COMBAT_POINT
    if [ e.pathtarget ]
        savetarget : string [ e.target ]
        e.target = e.pathtarget
        activator : other
        if [ other.enemy && other.enemy.client ]              activator = other.enemy
        el [ other.oldenemy && other.oldenemy.client ]        activator = other.oldenemy
        el [ other.activator && other.activator.client ]      activator = other.activator
        g.use_targets[ e, activator ]
        e.target = savetarget

func sp_point_combat [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    e.solid = SOLID_TRIGGER
    e.touch = lambda point_combat_touch[]
    e.mins = vec3f [ -8.0, -8.0, -16.0 ]
    e.maxs = vec3f [ 8.0, 8.0, 16.0 ]
    e.svflags = SVF_NOCLIENT
    g.world.link[ e ]

# ---- viewthing
func th_viewthing [ e: Edict ]
    e.frame = (e.frame + 1) % 7
    e.nextthink = g.level.time + FRAMETIME

func sp_viewthing [ e: Edict ]
    g.dprintf[ 'viewthing spawned' ]
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_BBOX
    e.renderfx = RF_FRAMELERP
    e.mins = vec3f [ -16.0, -16.0, -24.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 32.0 ]
    e.modelindex = g.modelindex[ 'models/objects/banner/tris.md2' ]
    g.world.link[ e ]
    e.nextthink = g.level.time + 0.5
    e.think = lambda th_viewthing[]

func sp_info_notnull [ e: Edict ]
    e.absmin = e.origin
    e.absmax = e.origin

# ---- light: a targeted light toggles its style
func light_use [ e: Edict, other: Edict, activator: Edict ]
    if [ e.spawnflags & 1 ]
        g.set_lightstyle[ e.style, 109 ]
        e.spawnflags = e.spawnflags & ~1
    el
        g.set_lightstyle[ e.style, 97 ]
        e.spawnflags = e.spawnflags | 1

func sp_light_point [ e: Edict ]
    # no targeted lights in deathmatch, because they cause global messages
    if [ !e.targetname || g.deathmatch ]
        g.free_edict[ e ]
        return
    if [ e.style >= 32 ]
        e.use = lambda light_use[]
        if [ e.spawnflags & 1 ] g.set_lightstyle[ e.style, 97 ]
        el                      g.set_lightstyle[ e.style, 109 ]

# ---- misc_explobox: the barrel
func barrel_touch [ e: Edict, other: Edict ]
    if [ !other.groundentity || other.groundentity == e ] return
    ratio : f32 [ f32[ other.mass ] / f32[ e.mass ] ]
    v : v_sub[ e.origin, other.origin ]
    m_walkmove[ e, vectoyaw[ v ], 20.0 * ratio * FRAMETIME ]

func barrel_chunk [ e: Edict, model: string, spd: f32 ]
    org : vec3f [ e.origin.x + crandom[] * e.size.x,
                  e.origin.y + crandom[] * e.size.y,
                  e.origin.z + crandom[] * e.size.z ]
    throw_debris[ e, model, spd, org ]

func barrel_explode [ e: Edict ]
    t_radius_damage[ e, e.activator, f32[ e.dmg ], null, f32[ e.dmg + 40 ],
                     MOD_BARREL ]
    save : vec3f [ e.origin ]
    e.origin = v_ma[ e.absmin, 0.5, e.size ]
    # a few big chunks
    spd : f32 [ 1.5 * f32[ e.dmg ] / 200.0 ]
    barrel_chunk[ e, 'models/objects/debris1/tris.md2', spd ]
    barrel_chunk[ e, 'models/objects/debris1/tris.md2', spd ]
    # bottom corners
    spd = 1.75 * f32[ e.dmg ] / 200.0
    org : vec3f [ e.absmin ]
    throw_debris[ e, 'models/objects/debris3/tris.md2', spd, org ]
    org = vec3f [ e.absmin.x + e.size.x, e.absmin.y, e.absmin.z ]
    throw_debris[ e, 'models/objects/debris3/tris.md2', spd, org ]
    org = vec3f [ e.absmin.x, e.absmin.y + e.size.y, e.absmin.z ]
    throw_debris[ e, 'models/objects/debris3/tris.md2', spd, org ]
    org = vec3f [ e.absmin.x + e.size.x, e.absmin.y + e.size.y, e.absmin.z ]
    throw_debris[ e, 'models/objects/debris3/tris.md2', spd, org ]
    # a bunch of little chunks
    spd = 2.0 * f32[ e.dmg ] / 200.0
    for [ i: i32 0, i < 8, i += 1 ]
        barrel_chunk[ e, 'models/objects/debris2/tris.md2', spd ]
    e.origin = save
    if [ e.groundentity ] become_explosion2[ e ]
    el                    become_explosion1[ e ]

func barrel_delay [ e: Edict, inflictor: Edict, attacker: Edict,
                    damage: i32, point: vec3f ]
    e.takedamage = DAMAGE_NO
    e.nextthink = g.level.time + 2.0 * FRAMETIME
    e.think = lambda barrel_explode[]
    e.activator = attacker

func sp_misc_explobox [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    g.modelindex[ 'models/objects/debris1/tris.md2' ]
    g.modelindex[ 'models/objects/debris2/tris.md2' ]
    g.modelindex[ 'models/objects/debris3/tris.md2' ]
    e.solid = SOLID_BBOX
    e.movetype = MOVETYPE_STEP
    e.model = 'models/objects/barrels/tris.md2'
    e.modelindex = g.modelindex[ e.model ]
    e.mins = vec3f [ -16.0, -16.0, 0.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 40.0 ]
    if [ e.mass == 0 ] e.mass = 400
    if [ e.health == 0 ] e.health = 10
    if [ e.dmg == 0 ] e.dmg = 150
    e.die = lambda barrel_delay[]
    e.takedamage = DAMAGE_YES
    e.monsterinfo.aiflags = AI_NOSTEP
    e.touch = lambda barrel_touch[]
    e.think = lambda m_droptofloor[]
    e.nextthink = g.level.time + 2.0 * FRAMETIME
    g.world.link[ e ]

# ---- the decorations with a frame loop
func frame_loop [ e: Edict, first: i32, last: i32 ]
    e.frame += 1
    if [ e.frame >= last ] e.frame = first
    e.nextthink = g.level.time + FRAMETIME

func misc_blackhole_use [ e: Edict, other: Edict, activator: Edict ]
    g.free_edict[ e ]

func misc_blackhole_think [ e: Edict ]
    frame_loop[ e, 0, 19 ]

func sp_misc_blackhole [ e: Edict ]
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_NOT
    e.mins = vec3f [ -64.0, -64.0, 0.0 ]
    e.maxs = vec3f [ 64.0, 64.0, 8.0 ]
    e.modelindex = g.modelindex[ 'models/objects/black/tris.md2' ]
    e.renderfx = RF_TRANSLUCENT
    e.use = lambda misc_blackhole_use[]
    e.think = lambda misc_blackhole_think[]
    e.nextthink = g.level.time + 2.0 * FRAMETIME
    g.world.link[ e ]

func misc_eastertank_think [ e: Edict ]
    frame_loop[ e, 254, 293 ]

func sp_misc_eastertank [ e: Edict ]
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_BBOX
    e.mins = vec3f [ -32.0, -32.0, -16.0 ]
    e.maxs = vec3f [ 32.0, 32.0, 32.0 ]
    e.modelindex = g.modelindex[ 'models/monsters/tank/tris.md2' ]
    e.frame = 254
    e.think = lambda misc_eastertank_think[]
    e.nextthink = g.level.time + 2.0 * FRAMETIME
    g.world.link[ e ]

func misc_easterchick_think [ e: Edict ]
    frame_loop[ e, 208, 247 ]

func sp_misc_easterchick [ e: Edict ]
    e.movetype = MOVETYPE_NONE
    e.solid = SOLID_BBOX
    e.mins = vec3f [ -32.0, -32.0, 0.0 ]
    e.maxs = vec3f [ 32.0, 32.0, 32.0 ]
    e.modelindex = g.modelindex[ 'models/monsters/bitch/tris.md2' ]
    e.frame = 208
