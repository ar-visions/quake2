# g_save.c: the game and a level as lines of text, and back
# made by gensave.py from Game.ag's classes: do not edit by hand
extend quake2

class SaveOut
    public name : string
    public out  : vec string

    func init []
        out = vec string []

    public func put_i [ v: i32 ]
        t : '{v}'
        out.push[ t ]

    # a float goes as its bits: it comes back exact
    public func put_f [ v: f32 ]
        value : f32 [ v ]
        bits : i32 [ 0 ]
        memcpy[ @bits, @value, 4 ]
        t : '{bits}'
        out.push[ t ]

    public func put_v [ v: vec3f ]
        put_f[ v.x ]
        put_f[ v.y ]
        put_f[ v.z ]

    public func put_q [ v: vec4f ]
        put_f[ v.x ]
        put_f[ v.y ]
        put_f[ v.z ]
        put_f[ v.w ]

    # ~ is no string; = leads one; a line break goes as byte 1
    public func put_s [ s: string ]
        buf : local i8 [ 2048 ]
        if [ !s ]
            # a fresh string each time, never the literal itself
            buf[ 0 ] = 126
            buf[ 1 ] = 0
            none : string [ cast cstr [ buf ] ]
            out.push[ none ]
            return
        buf[ 0 ] = 61
        n : i32 [ 1 ]
        for [ i: i32 0, i < s.count && n < 2046, i += 1 ]
            c : i32 [ s[ i ] ]
            if [ c == 10 ] c = 1
            buf[ n ] = c
            n += 1
        buf[ n ] = 0
        t : string [ cast cstr [ buf ] ]
        out.push[ t ]

    public func put_ints [ v: vec i32 ]
        if [ !v ]
            put_i[ 0 - 1 ]
            return
        put_i[ v.count ]
        for [ i: i32 0, i < v.count, i += 1 ]
            put_i[ v[ i ] ]

    public func put_strs [ v: vec string ]
        put_i[ v.count ]
        for [ i: i32 0, i < v.count, i += 1 ]
            put_s[ v[ i ] ]

    public func append [ other: SaveOut ]
        put_i[ other.out.count ]
        for [ i: i32 0, i < other.out.count, i += 1 ]
            w : other.out[ i ]
            out.push[ w ]

class SaveIn
    public words : vec string
    public at    : i32

    public func get_i [] -> i32
        if [ at >= words.count ] return 0
        w : words[ at ]
        at += 1
        return atoi[ w.chars ]

    public func get_f [] -> f32
        bits : i32 [ get_i[] ]
        value : f32 [ 0.0 ]
        memcpy[ @value, @bits, 4 ]
        return value

    public func get_v [] -> vec3f
        x : f32 [ get_f[] ]
        y : f32 [ get_f[] ]
        z : f32 [ get_f[] ]
        return vec3f [ x, y, z ]

    public func get_q [] -> vec4f
        x : f32 [ get_f[] ]
        y : f32 [ get_f[] ]
        z : f32 [ get_f[] ]
        w : f32 [ get_f[] ]
        return vec4f [ x, y, z, w ]

    public func get_s [] -> string
        if [ at >= words.count ] return null
        w : words[ at ]
        at += 1
        if [ w.count == 0 || w[ 0 ] == 126 ] return null
        buf : local i8 [ 2048 ]
        n : i32 [ 0 ]
        for [ i: i32 1, i < w.count && n < 2046, i += 1 ]
            c : i32 [ w[ i ] ]
            if [ c == 1 ] c = 10
            buf[ n ] = c
            n += 1
        buf[ n ] = 0
        return string [ cast cstr [ buf ] ]

    public func get_ints [] -> vec i32
        n : i32 [ get_i[] ]
        if [ n < 0 ] return null
        v : vec i32 []
        for [ i: i32 0, i < n, i += 1 ]
            item : i32 [ get_i[] ]
            v.push[ item ]
        return v

    public func get_strs [] -> vec string
        n : i32 [ get_i[] ]
        v : vec string []
        for [ i: i32 0, i < n, i += 1 ]
            item : get_s[]
            v.push[ item ]
        return v

    # the next block another SaveOut appended, as its own writer
    public func take [] -> SaveOut
        n : i32 [ get_i[] ]
        s : SaveOut [ ]
        for [ i: i32 0, i < n && at < words.count, i += 1 ]
            s.out.push[ words[ at ] ]
            at += 1
        return s

func save_edict [ n: i32 ] -> Edict
    if [ n < 0 || n >= g.edicts.count ] return null
    return g.edicts[ n ]

func save_item_no [ it: GItem ] -> i32
    if [ it ]
        for [ i: i32 0, i < g.num_items, i += 1 ]
            if [ g.items[ i ] == it ] return i
    return 0 - 1

func save_item [ n: i32 ] -> GItem
    if [ n < 0 || n >= g.num_items ] return null
    return g.items[ n ]

# WriteGame: what crosses levels
func write_game [ s: SaveOut ]
    s.put_s[ g.helpmessage1 ]
    s.put_s[ g.helpmessage2 ]
    s.put_i[ g.helpchanged ]
    s.put_i[ g.serverflags ]
    s.put_i[ g.skill ]
    s.put_s[ g.spawnpoint ]

func read_game [ s: SaveIn ]
    g.helpmessage1 = s.get_s[]
    g.helpmessage2 = s.get_s[]
    g.helpchanged = s.get_i[]
    g.serverflags = s.get_i[]
    g.skill = s.get_i[]
    g.spawnpoint = s.get_s[]

# WriteLevel: every edict in use; a hub's copy leaves clients out
func write_level [ hub: bool ] -> SaveOut
    s : SaveOut [ ]
    s.put_i[ g.num_edicts ]
    save_Level[ s, g.level ]
    s.put_ints[ g.lightstyles ]
    s.put_strs[ g.models ]
    s.put_strs[ g.sounds ]
    s.put_strs[ g.images ]
    for [ i: i32 0, i < g.num_edicts, i += 1 ]
        e : g.edicts[ i ]
        if [ !e.inuse ] continue
        if [ hub && e.client ] continue
        s.put_i[ i ]
        save_Edict[ s, e ]
    s.put_i[ 0 - 1 ]
    return s

# ReadLevel, over a level SpawnEntities has just made
func read_level [ s: SaveIn, hub: bool ]
    count : i32 [ s.get_i[] ]
    load_Level[ s, g.level ]
    g.lightstyles = s.get_ints[]
    g.models = s.get_strs[]
    g.sounds = s.get_strs[]
    g.images = s.get_strs[]
    # wipe all the entities; a hub return keeps the new client
    for [ i: i32 0, i < g.num_edicts, i += 1 ]
        e : g.edicts[ i ]
        if [ hub && e.client ] continue
        if [ e.inuse ] g.world.unlink[ e ]
        e.inuse = false
    if [ count > g.num_edicts && count <= g.edicts.count ]
        g.num_edicts = count
    while [ true ]
        n : i32 [ s.get_i[] ]
        if [ n < 0 || n >= g.edicts.count ] break
        e : g.edicts[ n ]
        load_Edict[ s, e ]
    for [ i: i32 0, i < g.num_edicts, i += 1 ]
        e : g.edicts[ i ]
        if [ !e.inuse ] continue
        if [ hub && e.client ] continue
        g.world.link[ e ]
        # fire any cross-level triggers
        if [ e.classname && e.classname == 'target_crosslevel_target' ]
            e.nextthink = g.level.time + e.delay

# save<n>.sav in the app's cache folder
func save_file [ n: i32 ] -> string
    app : 'quake2'
    dir : '{path.path_cache[ app.chars ]}'
    return '{dir}/save{n}.sav'

func save_write [ file: string, s: SaveOut ] -> bool
    f : fopen[ file.chars, "w" ]
    if [ !f ] return false
    for [ w: string ] in s.out
        fputs[ w.chars, f ]
        fputs[ "\n", f ]
    fclose[ f ]
    return true

# the first lines of a file, or all of it when most is 0
func save_read [ file: string, most: i32 ] -> SaveIn
    f : fopen[ file.chars, "r" ]
    if [ !f ] return null
    words : vec string []
    buf : local i8 [ 4096 ]
    while [ most == 0 || words.count < most ]
        got : cstr [ fgets[ buf, 4096, f ] ]
        if [ !got ] break
        n : i32 [ strlen[ buf ] ]
        if [ n > 0 && buf[ n - 1 ] == 10 ] buf[ n - 1 ] = 0
        word : string [ cast cstr [ buf ] ]
        words.push[ word ]
    fclose[ f ]
    return SaveIn [ words: words ]


