func save_Level [ s: SaveOut, o: Level ]
    s.put_i[ o.framenum ]
    s.put_f[ o.time ]
    s.put_s[ o.level_name ]
    s.put_s[ o.mapname ]
    s.put_s[ o.nextmap ]
    s.put_s[ o.changemap ]
    s.put_i[ (o.current_entity) ? o.current_entity.number : 0 - 1 ]
    s.put_i[ o.found_secrets ]
    s.put_i[ o.total_secrets ]
    s.put_i[ o.found_goals ]
    s.put_i[ o.total_goals ]
    s.put_f[ o.intermissiontime ]
    s.put_i[ (o.exitintermission) ? 1 : 0 ]
    s.put_v[ o.intermission_origin ]
    s.put_v[ o.intermission_angle ]
    s.put_i[ (o.sight_client) ? o.sight_client.number : 0 - 1 ]
    s.put_i[ (o.sight_entity) ? o.sight_entity.number : 0 - 1 ]
    s.put_i[ o.sight_entity_framenum ]
    s.put_i[ (o.sound_entity) ? o.sound_entity.number : 0 - 1 ]
    s.put_i[ o.sound_entity_framenum ]
    s.put_i[ (o.sound2_entity) ? o.sound2_entity.number : 0 - 1 ]
    s.put_i[ o.sound2_entity_framenum ]
    s.put_i[ o.pic_health ]
    s.put_i[ o.total_monsters ]
    s.put_i[ o.killed_monsters ]
    s.put_i[ o.body_que ]
    s.put_i[ o.power_cubes ]

