# m_soldier.c: light (blaster), soldier (shotgun), ss
# (machinegun); skinnum picks the weapon
extend quake2

soldier_sound_idle : i32
soldier_sound_sight1 : i32
soldier_sound_sight2 : i32
soldier_sound_pain_light : i32
soldier_sound_pain : i32
soldier_sound_pain_ss : i32
soldier_sound_death_light : i32
soldier_sound_death : i32
soldier_sound_death_ss : i32
soldier_sound_cock : i32
soldier_move_stand1 : MMove
soldier_move_stand3 : MMove
soldier_move_walk1 : MMove
soldier_move_walk2 : MMove
soldier_move_start_run : MMove
soldier_move_run : MMove
soldier_move_pain1 : MMove
soldier_move_pain2 : MMove
soldier_move_pain3 : MMove
soldier_move_pain4 : MMove
soldier_move_attack1 : MMove
soldier_move_attack2 : MMove
soldier_move_attack3 : MMove
soldier_move_attack4 : MMove
soldier_move_attack6 : MMove
soldier_move_duck : MMove
soldier_move_death1 : MMove
soldier_move_death2 : MMove
soldier_move_death3 : MMove
soldier_move_death4 : MMove
soldier_move_death5 : MMove
soldier_move_death6 : MMove

func soldier_idle [ e: Edict ]
    if [ frand[] > 0.8 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_idle, 1.0, ATTN_IDLE ]

func soldier_cock [ e: Edict ]
    # stand322 is 197
    if [ e.frame == 197 ]
        g.sound[ e, CHAN_WEAPON, soldier_sound_cock, 1.0, ATTN_IDLE ]
    el
        g.sound[ e, CHAN_WEAPON, soldier_sound_cock, 1.0, ATTN_NORM ]

# STAND
func soldier_stand [ e: Edict ]
    mi : e.monsterinfo
    if [ mi.currentmove == soldier_move_stand3 ||
         frand[] < 0.8 ]
        mi.currentmove = soldier_move_stand1
    el
        mi.currentmove = soldier_move_stand3

# WALK
func soldier_walk1_random [ e: Edict ]
    # walk101 is 215
    if [ frand[] > 0.1 ] e.monsterinfo.nextframe = 215

func soldier_walk [ e: Edict ]
    if [ frand[] < 0.5 ] e.monsterinfo.currentmove = soldier_move_walk1
    el                   e.monsterinfo.currentmove = soldier_move_walk2

# RUN
func soldier_run [ e: Edict ]
    mi : e.monsterinfo
    if [ mi.aiflags & AI_STAND_GROUND ]
        mi.currentmove = soldier_move_stand1
        return
    if [ mi.currentmove == soldier_move_walk1 ||
         mi.currentmove == soldier_move_walk2 ||
         mi.currentmove == soldier_move_start_run ]
        mi.currentmove = soldier_move_run
    el
        mi.currentmove = soldier_move_start_run

# PAIN
func soldier_pain [ e: Edict, other: Edict, kick: f32, damage: i32 ]
    mi : e.monsterinfo
    if [ e.health < (e.max_health / 2) ] e.skinnum = e.skinnum | 1
    if [ g.level.time < e.pain_debounce_time ]
        if [ e.velocity.z > 100.0 &&
             (mi.currentmove == soldier_move_pain1 ||
              mi.currentmove == soldier_move_pain2 ||
              mi.currentmove == soldier_move_pain3) ]
            mi.currentmove = soldier_move_pain4
        return
    e.pain_debounce_time = g.level.time + 3.0
    n : i32 [ e.skinnum | 1 ]
    if [ n == 1 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_pain_light, 1.0,
                 ATTN_NORM ]
    el [ n == 3 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_pain, 1.0, ATTN_NORM ]
    el
        g.sound[ e, CHAN_VOICE, soldier_sound_pain_ss, 1.0, ATTN_NORM ]
    if [ e.velocity.z > 100.0 ]
        mi.currentmove = soldier_move_pain4
        return
    # no pain anims in nightmare
    if [ g.skill == 3 ] return
    r : f32 [ frand[] ]
    if [ r < 0.33 ]      mi.currentmove = soldier_move_pain1
    el [ r < 0.66 ]      mi.currentmove = soldier_move_pain2
    el                   mi.currentmove = soldier_move_pain3

# ATTACK
soldier_blaster_flash : vec i32
soldier_shotgun_flash : vec i32
soldier_machinegun_flash : vec i32

func soldier_fire [ e: Edict, flash_number: i32 ]
    flash_index : i32 [ 0 ]
    if [ e.skinnum < 2 ]
        flash_index = soldier_blaster_flash[ flash_number ]
    el [ e.skinnum < 4 ]
        flash_index = soldier_shotgun_flash[ flash_number ]
    el
        flash_index = soldier_machinegun_flash[ flash_number ]
    ax : angle_vectors[ e.angles ]
    start : project_source[ e.origin, flash_offset[ flash_index ],
                            ax.forward, ax.right ]
    aim : vec3f [ ax.forward ]
    if [ flash_number != 5 && flash_number != 6 ]
        end : vec3f [ e.enemy.origin.x, e.enemy.origin.y,
                      e.enemy.origin.z + f32[ e.enemy.viewheight ] ]
        aim = v_sub[ end, start ]
        dir : vectoangles[ aim ]
        bx : angle_vectors[ dir ]
        r : f32 [ crandom[] * 1000.0 ]
        u : f32 [ crandom[] * 500.0 ]
        end = v_ma[ start, 8192.0, bx.forward ]
        end = v_ma[ end, r, bx.right ]
        end = v_ma[ end, u, bx.up ]
        aim = v_norm[ v_sub[ end, start ] ]
    if [ e.skinnum <= 1 ]
        monster_fire_blaster[ e, start, aim, 5, 600, flash_index,
                              EF_BLASTER ]
    el [ e.skinnum <= 3 ]
        monster_fire_shotgun[ e, start, aim, 2, 1,
                              DEFAULT_SHOTGUN_HSPREAD,
                              DEFAULT_SHOTGUN_VSPREAD,
                              DEFAULT_SHOTGUN_COUNT, flash_index ]
    el
        mi : e.monsterinfo
        if [ (mi.aiflags & AI_HOLD_FRAME) == 0 ]
            mi.pausetime = g.level.time +
                f32[ 3 + rand[] % 8 ] * FRAMETIME
        monster_fire_bullet[ e, start, aim, 2, 4,
                             DEFAULT_BULLET_HSPREAD,
                             DEFAULT_BULLET_VSPREAD, flash_index ]
        if [ g.level.time >= mi.pausetime ]
            mi.aiflags = mi.aiflags & ~AI_HOLD_FRAME
        el
            mi.aiflags = mi.aiflags | AI_HOLD_FRAME

# ATTACK1 (blaster/shotgun)
func soldier_fire1 [ e: Edict ]
    soldier_fire[ e, 0 ]

func soldier_attack1_refire1 [ e: Edict ]
    if [ e.skinnum > 1 ] return
    if [ e.enemy.health <= 0 ] return
    # attak102 is 1, attak110 is 9
    if [ (g.skill == 3 && frand[] < 0.5) ||
         ai_range[ e, e.enemy ] == RANGE_MELEE ]
        e.monsterinfo.nextframe = 1
    el
        e.monsterinfo.nextframe = 9

func soldier_attack1_refire2 [ e: Edict ]
    if [ e.skinnum < 2 ] return
    if [ e.enemy.health <= 0 ] return
    if [ (g.skill == 3 && frand[] < 0.5) ||
         ai_range[ e, e.enemy ] == RANGE_MELEE ]
        e.monsterinfo.nextframe = 1

# ATTACK2 (blaster/shotgun)
func soldier_fire2 [ e: Edict ]
    soldier_fire[ e, 1 ]

func soldier_attack2_refire1 [ e: Edict ]
    if [ e.skinnum > 1 ] return
    if [ e.enemy.health <= 0 ] return
    # attak204 is 15, attak216 is 27
    if [ (g.skill == 3 && frand[] < 0.5) ||
         ai_range[ e, e.enemy ] == RANGE_MELEE ]
        e.monsterinfo.nextframe = 15
    el
        e.monsterinfo.nextframe = 27

func soldier_attack2_refire2 [ e: Edict ]
    if [ e.skinnum < 2 ] return
    if [ e.enemy.health <= 0 ] return
    if [ (g.skill == 3 && frand[] < 0.5) ||
         ai_range[ e, e.enemy ] == RANGE_MELEE ]
        e.monsterinfo.nextframe = 15

# ATTACK3 (duck and shoot)
func soldier_duck_down [ e: Edict ]
    mi : e.monsterinfo
    if [ mi.aiflags & AI_DUCKED ] return
    mi.aiflags = mi.aiflags | AI_DUCKED
    e.maxs = vec3f [ e.maxs.x, e.maxs.y, e.maxs.z - 32.0 ]
    e.takedamage = DAMAGE_YES
    mi.pausetime = g.level.time + 1.0
    g.world.link[ e ]

func soldier_duck_up [ e: Edict ]
    e.monsterinfo.aiflags = e.monsterinfo.aiflags & ~AI_DUCKED
    e.maxs = vec3f [ e.maxs.x, e.maxs.y, e.maxs.z + 32.0 ]
    e.takedamage = DAMAGE_AIM
    g.world.link[ e ]

func soldier_fire3 [ e: Edict ]
    soldier_duck_down[ e ]
    soldier_fire[ e, 2 ]

func soldier_attack3_refire [ e: Edict ]
    # attak303 is 32
    if [ (g.level.time + 0.4) < e.monsterinfo.pausetime ]
        e.monsterinfo.nextframe = 32

# ATTACK4 (machinegun)
func soldier_fire4 [ e: Edict ]
    soldier_fire[ e, 3 ]

# ATTACK6 (run & shoot)
func soldier_fire8 [ e: Edict ]
    soldier_fire[ e, 7 ]

func soldier_attack6_refire [ e: Edict ]
    if [ e.enemy.health <= 0 ] return
    if [ ai_range[ e, e.enemy ] < RANGE_MID ] return
    # runs03 is 111
    if [ g.skill == 3 ] e.monsterinfo.nextframe = 111

func soldier_attack [ e: Edict ]
    mi : e.monsterinfo
    if [ e.skinnum < 4 ]
        if [ frand[] < 0.5 ] mi.currentmove = soldier_move_attack1
        el                   mi.currentmove = soldier_move_attack2
    el
        mi.currentmove = soldier_move_attack4

# SIGHT
func soldier_sight [ e: Edict, other: Edict ]
    if [ frand[] < 0.5 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_sight1, 1.0, ATTN_NORM ]
    el
        g.sound[ e, CHAN_VOICE, soldier_sound_sight2, 1.0, ATTN_NORM ]
    if [ g.skill > 0 && ai_range[ e, e.enemy ] >= RANGE_MID ]
        if [ frand[] > 0.5 ]
            e.monsterinfo.currentmove = soldier_move_attack6

# DUCK
func soldier_duck_hold [ e: Edict ]
    mi : e.monsterinfo
    if [ g.level.time >= mi.pausetime ]
        mi.aiflags = mi.aiflags & ~AI_HOLD_FRAME
    el
        mi.aiflags = mi.aiflags | AI_HOLD_FRAME

func soldier_dodge [ e: Edict, attacker: Edict, eta: f32 ]
    r : f32 [ frand[] ]
    if [ r > 0.25 ] return
    if [ !e.enemy ] e.enemy = attacker
    mi : e.monsterinfo
    if [ g.skill == 0 ]
        mi.currentmove = soldier_move_duck
        return
    mi.pausetime = g.level.time + eta + 0.3
    r = frand[]
    if [ g.skill == 1 ]
        if [ r > 0.33 ] mi.currentmove = soldier_move_duck
        el              mi.currentmove = soldier_move_attack3
        return
    if [ g.skill >= 2 ]
        if [ r > 0.66 ] mi.currentmove = soldier_move_duck
        el              mi.currentmove = soldier_move_attack3
        return
    mi.currentmove = soldier_move_attack3

# DEATH
func soldier_fire6 [ e: Edict ]
    soldier_fire[ e, 5 ]

func soldier_fire7 [ e: Edict ]
    soldier_fire[ e, 6 ]

func soldier_dead [ e: Edict ]
    e.mins = vec3f [ -16.0, -16.0, -24.0 ]
    e.maxs = vec3f [ 16.0, 16.0, -8.0 ]
    e.movetype = MOVETYPE_TOSS
    e.svflags = e.svflags | SVF_DEADMONSTER
    e.nextthink = 0.0
    g.world.link[ e ]

func soldier_die [ e: Edict, inflictor: Edict, attacker: Edict,
                   damage: i32, point: vec3f ]
    # check for gib
    if [ e.health <= e.gib_health ]
        g.sound[ e, CHAN_VOICE, g.soundindex[ 'misc/udeath.wav' ], 1.0,
                 ATTN_NORM ]
        for [ n: i32 0, n < 3, n += 1 ]
            throw_gib[ e, 'models/objects/gibs/sm_meat/tris.md2',
                       damage, GIB_ORGANIC ]
        throw_gib[ e, 'models/objects/gibs/chest/tris.md2', damage,
                   GIB_ORGANIC ]
        throw_head[ e, 'models/objects/gibs/head2/tris.md2', damage,
                    GIB_ORGANIC ]
        e.deadflag = DEAD_DEAD
        return
    if [ e.deadflag == DEAD_DEAD ] return
    # regular death
    e.deadflag = DEAD_DEAD
    e.takedamage = DAMAGE_YES
    e.skinnum = e.skinnum | 1
    if [ e.skinnum == 1 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_death_light, 1.0,
                 ATTN_NORM ]
    el [ e.skinnum == 3 ]
        g.sound[ e, CHAN_VOICE, soldier_sound_death, 1.0, ATTN_NORM ]
    el
        g.sound[ e, CHAN_VOICE, soldier_sound_death_ss, 1.0, ATTN_NORM ]
    mi : e.monsterinfo
    if [ fabs[ (e.origin.z + f32[ e.viewheight ]) - point.z ] <= 4.0 ]
        # head shot
        mi.currentmove = soldier_move_death3
        return
    n : i32 [ rand[] % 5 ]
    if [ n == 0 ]      mi.currentmove = soldier_move_death1
    el [ n == 1 ]      mi.currentmove = soldier_move_death2
    el [ n == 2 ]      mi.currentmove = soldier_move_death4
    el [ n == 3 ]      mi.currentmove = soldier_move_death5
    el                 mi.currentmove = soldier_move_death6

# SPAWN
func sp_monster_soldier_x [ e: Edict ]
    soldier_moves[]
    e.modelindex = g.modelindex[ 'models/monsters/soldier/tris.md2' ]
    e.monsterinfo.scale = 1.0
    e.mins = vec3f [ -16.0, -16.0, -24.0 ]
    e.maxs = vec3f [ 16.0, 16.0, 32.0 ]
    e.movetype = MOVETYPE_STEP
    e.solid = SOLID_BBOX
    soldier_sound_idle   = g.soundindex[ 'soldier/solidle1.wav' ]
    soldier_sound_sight1 = g.soundindex[ 'soldier/solsght1.wav' ]
    soldier_sound_sight2 = g.soundindex[ 'soldier/solsrch1.wav' ]
    soldier_sound_cock   = g.soundindex[ 'infantry/infatck3.wav' ]
    e.mass = 100
    e.pain = lambda soldier_pain[]
    e.die  = lambda soldier_die[]
    mi : e.monsterinfo
    mi.stand  = lambda soldier_stand[]
    mi.walk   = lambda soldier_walk[]
    mi.run    = lambda soldier_run[]
    mi.dodge  = lambda soldier_dodge[]
    mi.attack = lambda soldier_attack[]
    mi.melee  = null
    mi.sight  = lambda soldier_sight[]
    g.world.link[ e ]
    mi.stand[ e ]
    walkmonster_start[ e ]

func sp_monster_soldier_light [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    sp_monster_soldier_x[ e ]
    soldier_sound_pain_light  = g.soundindex[ 'soldier/solpain2.wav' ]
    soldier_sound_death_light = g.soundindex[ 'soldier/soldeth2.wav' ]
    g.modelindex[ 'models/objects/laser/tris.md2' ]
    g.soundindex[ 'misc/lasfly.wav' ]
    g.soundindex[ 'soldier/solatck2.wav' ]
    e.skinnum = 0
    e.health = 20
    e.gib_health = -30

func sp_monster_soldier [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    sp_monster_soldier_x[ e ]
    soldier_sound_pain  = g.soundindex[ 'soldier/solpain1.wav' ]
    soldier_sound_death = g.soundindex[ 'soldier/soldeth1.wav' ]
    g.soundindex[ 'soldier/solatck1.wav' ]
    e.skinnum = 2
    e.health = 30
    e.gib_health = -30

func sp_monster_soldier_ss [ e: Edict ]
    if [ g.deathmatch ]
        g.free_edict[ e ]
        return
    sp_monster_soldier_x[ e ]
    soldier_sound_pain_ss  = g.soundindex[ 'soldier/solpain3.wav' ]
    soldier_sound_death_ss = g.soundindex[ 'soldier/soldeth3.wav' ]
    g.soundindex[ 'soldier/solatck3.wav' ]
    e.skinnum = 4
    e.health = 40
    e.gib_health = -30

# the moves, built once: frame numbers from m_soldier.h
func soldier_moves []
    if [ soldier_move_stand1 ] return
    soldier_blaster_flash = vec i32 [] [ MZ2_SOLDIER_BLASTER_1,
        MZ2_SOLDIER_BLASTER_2, MZ2_SOLDIER_BLASTER_3,
        MZ2_SOLDIER_BLASTER_4, MZ2_SOLDIER_BLASTER_5,
        MZ2_SOLDIER_BLASTER_6, MZ2_SOLDIER_BLASTER_7,
        MZ2_SOLDIER_BLASTER_8 ]
    soldier_shotgun_flash = vec i32 [] [ MZ2_SOLDIER_SHOTGUN_1,
        MZ2_SOLDIER_SHOTGUN_2, MZ2_SOLDIER_SHOTGUN_3,
        MZ2_SOLDIER_SHOTGUN_4, MZ2_SOLDIER_SHOTGUN_5,
        MZ2_SOLDIER_SHOTGUN_6, MZ2_SOLDIER_SHOTGUN_7,
        MZ2_SOLDIER_SHOTGUN_8 ]
    soldier_machinegun_flash = vec i32 [] [ MZ2_SOLDIER_MACHINEGUN_1,
        MZ2_SOLDIER_MACHINEGUN_2, MZ2_SOLDIER_MACHINEGUN_3,
        MZ2_SOLDIER_MACHINEGUN_4, MZ2_SOLDIER_MACHINEGUN_5,
        MZ2_SOLDIER_MACHINEGUN_6, MZ2_SOLDIER_MACHINEGUN_7,
        MZ2_SOLDIER_MACHINEGUN_8 ]
    v : vec MFrame []
    mf[ v, 1, lambda ai_stand[], 0.0, lambda soldier_idle[] ]
    mf[ v, 29, lambda ai_stand[], 0.0, null ]
    # stand101 .. stand130
    soldier_move_stand1 = MMove [ firstframe: 146, lastframe: 175,
        frames: v, endfunc: lambda soldier_stand[] ]
    v = vec MFrame []
    mf[ v, 21, lambda ai_stand[], 0.0, null ]
    mf[ v, 1, lambda ai_stand[], 0.0, lambda soldier_cock[] ]
    mf[ v, 17, lambda ai_stand[], 0.0, null ]
    # stand301 .. stand339
    soldier_move_stand3 = MMove [ firstframe: 176, lastframe: 214,
        frames: v, endfunc: lambda soldier_stand[] ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_walk[], 3.0, null ]
    mf[ v, 1, lambda ai_walk[], 6.0, null ]
    mf[ v, 3, lambda ai_walk[], 2.0, null ]
    mf[ v, 1, lambda ai_walk[], 1.0, null ]
    mf[ v, 1, lambda ai_walk[], 6.0, null ]
    mf[ v, 1, lambda ai_walk[], 5.0, null ]
    mf[ v, 1, lambda ai_walk[], 3.0, null ]
    mf[ v, 1, lambda ai_walk[], -1.0, lambda soldier_walk1_random[] ]
    mf[ v, 23, lambda ai_walk[], 0.0, null ]
    # walk101 .. walk133
    soldier_move_walk1 = MMove [ firstframe: 215, lastframe: 247,
        frames: v, endfunc: null ]
    v = vec MFrame []
    mf[ v, 2, lambda ai_walk[], 4.0, null ]
    mf[ v, 1, lambda ai_walk[], 9.0, null ]
    mf[ v, 1, lambda ai_walk[], 8.0, null ]
    mf[ v, 1, lambda ai_walk[], 5.0, null ]
    mf[ v, 1, lambda ai_walk[], 1.0, null ]
    mf[ v, 1, lambda ai_walk[], 3.0, null ]
    mf[ v, 1, lambda ai_walk[], 7.0, null ]
    mf[ v, 1, lambda ai_walk[], 6.0, null ]
    mf[ v, 1, lambda ai_walk[], 7.0, null ]
    # walk209 .. walk218
    soldier_move_walk2 = MMove [ firstframe: 256, lastframe: 265,
        frames: v, endfunc: null ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_run[], 7.0, null ]
    mf[ v, 1, lambda ai_run[], 5.0, null ]
    # run01 .. run02
    soldier_move_start_run = MMove [ firstframe: 97, lastframe: 98,
        frames: v, endfunc: lambda soldier_run[] ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_run[], 10.0, null ]
    mf[ v, 2, lambda ai_run[], 11.0, null ]
    mf[ v, 1, lambda ai_run[], 16.0, null ]
    mf[ v, 1, lambda ai_run[], 10.0, null ]
    mf[ v, 1, lambda ai_run[], 15.0, null ]
    # run03 .. run08
    soldier_move_run = MMove [ firstframe: 99, lastframe: 104,
        frames: v, endfunc: null ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_move[], -3.0, null ]
    mf[ v, 1, lambda ai_move[], 4.0, null ]
    mf[ v, 2, lambda ai_move[], 1.0, null ]
    mf[ v, 1, lambda ai_move[], 0.0, null ]
    # pain101 .. pain105
    soldier_move_pain1 = MMove [ firstframe: 50, lastframe: 54,
        frames: v, endfunc: lambda soldier_run[] ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_move[], -13.0, null ]
    mf[ v, 1, lambda ai_move[], -1.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 1, lambda ai_move[], 4.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 1, lambda ai_move[], 3.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    # pain201 .. pain207
    soldier_move_pain2 = MMove [ firstframe: 55, lastframe: 61,
        frames: v, endfunc: lambda soldier_run[] ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_move[], -8.0, null ]
    mf[ v, 1, lambda ai_move[], 10.0, null ]
    mf[ v, 1, lambda ai_move[], -4.0, null ]
    mf[ v, 1, lambda ai_move[], -1.0, null ]
    mf[ v, 1, lambda ai_move[], -3.0, null ]
    mf[ v, 1, lambda ai_move[], 0.0, null ]
    mf[ v, 1, lambda ai_move[], 3.0, null ]
    mf[ v, 4, lambda ai_move[], 0.0, null ]
    mf[ v, 1, lambda ai_move[], 1.0, null ]
    mf[ v, 1, lambda ai_move[], 0.0, null ]
    mf[ v, 1, lambda ai_move[], 1.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 1, lambda ai_move[], 4.0, null ]
    mf[ v, 1, lambda ai_move[], 3.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    # pain301 .. pain318
    soldier_move_pain3 = MMove [ firstframe: 62, lastframe: 79,
        frames: v, endfunc: lambda soldier_run[] ]
    v = vec MFrame []
    mf[ v, 3, lambda ai_move[], 0.0, null ]
    mf[ v, 1, lambda ai_move[], -10.0, null ]
    mf[ v, 1, lambda ai_move[], -6.0, null ]
    mf[ v, 1, lambda ai_move[], 8.0, null ]
    mf[ v, 1, lambda ai_move[], 4.0, null ]
    mf[ v, 1, lambda ai_move[], 1.0, null ]
    mf[ v, 1, lambda ai_move[], 0.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 1, lambda ai_move[], 5.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 2, lambda ai_move[], -1.0, null ]
    mf[ v, 1, lambda ai_move[], 3.0, null ]
    mf[ v, 1, lambda ai_move[], 2.0, null ]
    mf[ v, 1, lambda ai_move[], 0.0, null ]
    # pain401 .. pain417
    soldier_move_pain4 = MMove [ firstframe: 80, lastframe: 96,
        frames: v, endfunc: lambda soldier_run[] ]
