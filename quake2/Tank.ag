    mf[ v, 1, lambda ai_charge[], -1.0, null ]
    mf[ v, 1, lambda ai_charge[], -1.0, lambda tank_footstep[] ]
    mf[ v, 7, lambda ai_charge[], 0.0, null ]
    # attak331 .. attak353
    tank_move_attack_post_rocket = MMove [
        firstframe: 145, lastframe: 167, frames: v,
        endfunc: lambda tank_run[] ]
    v = vec MFrame []
    mf[ v, 5, lambda ai_charge[], 0.0, null ]
    mf[ v, 19, null, 0.0, lambda tank_machinegun[] ]
    mf[ v, 5, lambda ai_charge[], 0.0, null ]
    # attak401 .. attak429
    tank_move_attack_chain = MMove [
        firstframe: 168, lastframe: 196, frames: v,
        endfunc: lambda tank_run[] ]
    v = vec MFrame []
    mf[ v, 1, lambda ai_move[], -7.0, null ]
    mf[ v, 2, lambda ai_move[], -2.0, null ]
    mf[ v, 1, lambda ai_move[], 1.0, null ]
    mf[ v, 1, lambda ai_move[], 3.0, null ]
    mf[ v, 1, lambda ai_move[], 6.0, null ]
